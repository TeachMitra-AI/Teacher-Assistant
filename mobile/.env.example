# Base URL of the backend API (no trailing slash). On a physical device,
# "localhost" means the phone itself, not this development machine — see
# mobile/DEVICE_TESTING.md for the LAN-IP / `adb reverse tcp:3000 tcp:3000`
# options. In production point this at your deployed server, e.g.
# https://api.example.org/api
EXPO_PUBLIC_API_BASE=http://localhost:3000/api

# ---- Google Sign-In (native) ----
#
# docs/mobile-app-plan.md §16, §29. Unlike the web client's single
# VITE_GOOGLE_CLIENT_ID, Google Cloud Console issues a SEPARATE OAuth client
# ID per platform (Web, Android, iOS) even though the server only ever
# verifies the token's audience against ONE of them (GOOGLE_CLIENT_ID in
# server/.env.example) — confirm during setup which client ID that needs to
# be for expo-auth-session's id-token flow.
#
# The Google sign-in button on the login screen only renders when at least
# one of these three is set (mobile/src/auth/useGoogleIdToken.ts) — same
# "zero new UI, not a button that errors" default the web client's own
# VITE_GOOGLE_CLIENT_ID guard uses. Leaving all three unset hides the button
# entirely; email + password sign-in is unaffected.
#
# Also requires a custom development-client build from Phase 3 onward —
# Expo Go cannot open this app's `teacherassistant://` OAuth redirect
# (app.json's "scheme"). See mobile/DEVICE_TESTING.md.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---- Structured Question Model (Generator v2) ----
#
# When true, the Generator's result screen and the Library edit screen show
# the native per-question editor (QuestionCard/QuestionListEditor) instead of
# the flat Markdown textarea, whenever a generated/saved document has native
# structured questions (schemaVersion 2). When false (the default), any
# `structured` the server returns is treated as absent and every screen
# behaves exactly as it did before this feature existed — "zero new UI"
# default, mirroring the web client's VITE_STRUCTURED_QUESTIONS_ENABLED.
#
# NOT AN INCIDENT CONTROL — a build already installed on a device keeps
# whatever this was set to at build time. To turn the feature off quickly,
# use STRUCTURED_QUESTIONS_ENABLED on the SERVER instead: requesting one of
# the 3 new question types (descriptive/fill_blank/match) then 503s with
# STRUCTURED_QUESTIONS_DISABLED regardless of this flag's value.
#
# See docs/generator-v2-plan.md.
#
# Default: false.
EXPO_PUBLIC_STRUCTURED_QUESTIONS_ENABLED=false

# ---- Notifications ----
#
# Client-side gate for the in-app notification center (list, unread badge,
# realtime bell updates — mobile/src/notifications/NotificationContext.tsx).
# Same "not the real kill switch" caveat as every flag above: the server's
# NOTIFICATIONS_ENABLED is the immediately-effective one (every
# /api/notifications route 503s and the Socket.IO handshake rejects every
# connection regardless of this flag's value). Mirrors the web client's
# VITE_NOTIFICATIONS_ENABLED.
#
# Default: false.
EXPO_PUBLIC_NOTIFICATIONS_ENABLED=false

# ---- Push Notifications (Phase 7b) ----
#
# Client-side gate for OS-level push registration (mobile/src/lib/push.ts,
# mobile/src/notifications/NotificationContext.tsx). Same "not the real kill
# switch" caveat as every flag above: the server's MOBILE_PUSH_ENABLED is the
# immediately-effective one (both device-token routes 503 regardless of this
# flag's value). A SEPARATE flag from EXPO_PUBLIC_NOTIFICATIONS_ENABLED —
# this app can ship in-app/realtime notifications without OS push, or vice
# versa; see server/src/lib/flags.js's readMobilePushFlags doc comment.
#
# Push requires a development-client build (EAS Build or `expo run:android`)
# — Expo Go does NOT support push notifications on Android from Expo SDK 53
# onward. See mobile/DEVICE_TESTING.md and docs/mobile-app-plan.md §26 Phase
# 7b for the EAS project id / credential setup this also needs.
#
# Default: false.
EXPO_PUBLIC_MOBILE_PUSH_ENABLED=false
