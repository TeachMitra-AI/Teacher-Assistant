{
  "expo": {
    "name": "mobile",
    "slug": "rajeev-kumar",
    "version": "1.0.0",
    "scheme": "teacherassistant",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.teachmitra.assistant",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Teacher Assistant needs access to your photos so you can set a profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "30608c6d-68e3-4c34-adad-bb31e03eef5a"
      }
    },
    "owner": "rajeevnita2025s-team"
  }
}
