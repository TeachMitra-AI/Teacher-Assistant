node_modules/
.env
*.log
npm-debug.log*

# SQLite database files. The `.backup*` patterns matter as much as `*.db`:
# a copy of dev.db holds real user rows (emails, bcrypt hashes, googleSub
# values), and `prisma/*.db` alone does not match a name like
# `dev.db.backup-20260726`.
prisma/*.db
prisma/*.db-journal
prisma/*.db.backup*
prisma/*.backup
prisma/*.sqlite
prisma/*.sqlite3

# Throwaway test database (created/destroyed by the Vitest global setup)
test/*.db
test/*.db-journal
test/*.db-wal
test/*.db-shm
