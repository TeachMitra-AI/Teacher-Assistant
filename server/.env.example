# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file.

# Google Gemini API key (get one at https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model endpoint
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent

# Server port
PORT=3000

# Comma-separated list of origins allowed to call this API.
# Use the exact origin(s) your frontend is served from.
# Vite React client dev server runs on http://localhost:5173
# Example for local dev: http://localhost:5173,http://localhost:8000
#
# REQUIRED when NODE_ENV=production — the server will refuse to start if
# NODE_ENV is 'production' and this is left empty. In development (NODE_ENV
# unset or anything other than 'production'), it is ignored and any origin
# is allowed for convenience.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# ---- LLM reliability & cost controls ----
# All values below are integers. An invalid or out-of-range value is clamped
# to the safe bound (or default) with a startup warning rather than crashing,
# so a typo can't take the server down. Defaults are chosen to preserve normal
# answer quality while capping worst-case cost and latency.

# Timeout for a SINGLE Gemini API call, in milliseconds.
# Default 30000. Bounds: 1000–120000.
LLM_TIMEOUT_MS=30000

# Overall deadline for the ENTIRE /api/coach AI operation (initial call +
# retries + continuations combined), in milliseconds. Once exceeded, no
# further Gemini calls are made. Default 60000. Bounds: 5000–180000.
LLM_TOTAL_TIMEOUT_MS=60000

# Max retries for transient failures (429 / 5xx / network / timeout) PER
# logical call. Bounded further by LLM_MAX_CALLS_PER_REQUEST below.
# Default 2. Bounds: 0–5.
LLM_MAX_RETRIES=2

# Hard cap on the TOTAL number of Gemini API calls a single /api/coach request
# may make — shared across the initial call, every retry, and every
# continuation (and their retries). This is the ultimate cost ceiling per
# request. Default 8. Bounds: 1–20.
LLM_MAX_CALLS_PER_REQUEST=8

# Max number of continuation calls used to finish an answer that Gemini
# truncated at the output-token limit (long Indic-script answers may need a
# few). Also bounded by the call budget above. Default 4. Bounds: 0–8.
LLM_MAX_CONTINUATIONS=4

# Max output tokens Gemini may generate per call (supported generationConfig
# param). Kept high because Devanagari/Indic scripts use many tokens per
# character; continuation stitches longer answers together. Lowering this
# reduces cost but may truncate long answers sooner. Default 8192.
# Bounds: 256–8192.
LLM_MAX_OUTPUT_TOKENS=8192

# Rate limiting for POST /api/coach: window in minutes and max requests per
# window per IP. Leave RATE_LIMIT_MAX_REQUESTS unset to use the built-in
# environment-aware default: 60/window when NODE_ENV=production, 300/window
# otherwise (a single developer iterating on the UI can easily exceed 60 in
# 15 minutes; that shouldn't look like the same 429 a real abusive client
# would trigger). Set it explicitly to override either default — an explicit
# value always wins, in both dev and production.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=

# ---- Phase 2: database & auth ----

# SQLite database file (relative to the prisma/ folder). Swap for a PostgreSQL
# connection string later, e.g. postgresql://user:pass@host:5432/dbname
DATABASE_URL="file:./dev.db"

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# How long an ACCESS token stays valid. Kept short — the client silently
# exchanges it for a new one via the refresh token below, so this mainly
# bounds how long a stolen access token stays usable if a session is revoked.
ACCESS_TOKEN_TTL=15m

# How long a REFRESH token stays valid before the user must log in again from
# scratch. This is the effective "how long can I stay logged in" setting —
# each successful refresh issues a new one, so an active user is never
# logged out mid-session. Refresh tokens are stored hashed in the Session
# table and can be revoked at any time (logout, "sign out other devices",
# or an admin's "revoke sessions" action).
REFRESH_TOKEN_TTL_DAYS=7

# Login security: lock an account after this many consecutive failed password
# attempts, for this many minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Transactional email (password reset) ----

# Brevo API key, used only to send password-reset emails.
# Get one at https://brevo.com (Settings -> SMTP & API -> API Keys). The free
# tier is enough for a pilot.
#
# Brevo was chosen because it verifies a single sender ADDRESS — a plain Gmail
# is enough. Providers that only verify a DOMAIN would mean buying one before
# any teacher could receive a reset link.
#
# Unlike GEMINI_API_KEY and JWT_SECRET, leaving this unset does NOT stop the
# server from starting: everything except password reset keeps working, and
# /auth/forgot-password still returns its usual generic response while logging
# that the send was skipped. Set it to actually deliver reset emails.
BREVO_API_KEY=

# The From address on reset emails, as `Name <address>`. The address must be
# verified in Brevo (Senders, Domains & Dedicated IPs -> Senders); an
# unverified sender makes every send fail with a 4xx.
EMAIL_FROM=Teacher Assistant <your-verified-sender@example.com>

# Public URL of the FRONTEND, used to build the link in a reset email
# (<APP_URL>/reset-password/<token>). Must match where the client is actually
# served, or the link in the email will 404.
APP_URL=http://localhost:5173

# How long a password-reset link stays valid, in minutes. Short by design —
# the link is a bearer credential sitting in an inbox.
PASSWORD_RESET_TTL_MINUTES=60

# ---- Google Sign-In ----

# OAuth 2.0 Web application Client ID from the Google Cloud Console
# (APIs & Services -> Credentials). The server verifies every Google ID token
# against this value as the expected audience, so a token minted for some other
# app can never be used to sign in here.
#
# The SAME value must be set as VITE_GOOGLE_CLIENT_ID in the client's env.
# Leaving this unset disables Google sign-in (POST /auth/google returns 503);
# email + password sign-in is unaffected.
GOOGLE_CLIENT_ID=

# ---- AI Action Router (assistant) ----
#
# The assistant lets a teacher type "Generate a Class 5 fractions worksheet" and
# lands them on the Generator with the fields pre-filled, ready to review and
# click Generate. It never generates, saves, or deletes anything by itself.
#
# EVERY gate below is OFF by default. A deployment that sets none of these ships
# a completely inert assistant — forgetting to configure it can only
# under-enable the feature, never over-enable it.
#
# Values are parsed leniently (see src/lib/flags.js): an unrecognized value falls
# back to the safe default with a startup warning rather than crashing, matching
# how the LLM tunables above behave. Booleans accept true/1/yes/on and
# false/0/no/off.

# MASTER KILL SWITCH. When false, both assistant endpoints are inert: the
# catalog returns empty and every interpret call falls straight through to the
# coach. This is the ONLY reliable incident control — the client is a PWA with
# service-worker caching, so a client-side flag change propagates on some later
# page load rather than immediately. Flipping this and restarting takes effect
# in under a minute.
# Default: false.
ASSISTANT_ENABLED=false

# Per-action gate. Each action descriptor names its own variable, so enabling
# the assistant does not implicitly enable every capability it will ever have.
# Default for each: false.
ASSISTANT_ACTION_GENERATE_ASSESSMENT=false
ASSISTANT_ACTION_OPEN_GENERATOR=false

# Comma-separated roles allowed to use the assistant at all. The catalog is
# filtered by this BEFORE the classifier prompt is built, so a teacher's prompt
# never contains actions they could not perform anyway.
# Default: teacher
ASSISTANT_ALLOWED_ROLES=teacher

# Comma-separated school codes for staged tenant rollout. EMPTY MEANS ALL
# SCHOOLS — this is a filter, not a gate (ASSISTANT_ENABLED is the gate).
# Default: empty.
ASSISTANT_ALLOWED_SCHOOL_CODES=

# Interpret calls one user may make per day. Bounds a single account's cost.
# Exhausting it degrades to normal coach answers, not an error.
# Default 100. Bounds: 1-100000.
ASSISTANT_DAILY_BUDGET_PER_USER=100

# Per-IP request cap for /api/assistant/*, over the same window as
# RATE_LIMIT_WINDOW_MINUTES. A SEPARATE bucket from the /api/coach limiter on
# purpose: sharing one would let catalog fetches and routing decisions consume
# the budget a teacher needs for actual coaching answers. Higher than the coach
# ceiling because these calls are small and frequent rather than large and
# occasional.
# Default 120 in production, 600 in development. Bounds: 1-100000.
ASSISTANT_RATE_LIMIT_MAX_REQUESTS=120

# ---- Assistant LLM tunables (routing, NOT coaching) ----
#
# Routing runs on a SECOND GeminiService instance with its own, much tighter
# budget. The coaching values above (30s per call, 60s overall) are correct for
# generating a lesson plan and catastrophic for a routing decision that sits in
# front of a text box: a timeout here is a DECISION (fall through to the coach),
# not an error, so the budget must expire long before the teacher gives up.
#
# These take effect from milestone M5; until then they are documented but unused.

# Model endpoint used for routing only. A smaller/faster model is usually the
# right trade here — the task is short classification, not long-form writing.
ASSISTANT_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent

# Timeout for a SINGLE routing call, in milliseconds.
# Default 3500. Bounds: 1000-10000.
ASSISTANT_LLM_TIMEOUT_MS=3500

# Overall deadline for the ENTIRE routing decision. Once exceeded, the request
# falls through to the coach.
# Default 5000. Bounds: 2000-15000.
ASSISTANT_LLM_TOTAL_TIMEOUT_MS=5000

# Retries for transient routing failures. Deliberately lower than coaching:
# retrying a routing decision the teacher is waiting on is rarely worth it.
# Default 1. Bounds: 0-2.
ASSISTANT_LLM_MAX_RETRIES=1

# Hard cap on Gemini calls per routing request (initial + retries).
# Default 2. Bounds: 1-3.
ASSISTANT_LLM_MAX_CALLS=2

# Max output tokens for a routing response. A classification result is a small
# JSON object; a large cap here would only pay for tokens that are never used.
# Default 512. Bounds: 128-1024.
ASSISTANT_LLM_MAX_OUTPUT_TOKENS=512
