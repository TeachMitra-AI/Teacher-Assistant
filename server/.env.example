# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file.

# Google Gemini API key(s) (get one at https://makersuite.google.com/app/apikey)
# Accepts several comma-separated keys for automatic failover: when one hits its
# rate limit or quota, requests switch to the next available key, and the
# exhausted key rejoins at the next daily reset (see GEMINI_KEY_RESET_HOUR_IST /
# GEMINI_KEY_RESET_MINUTE_IST below). A single key works as before.
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY=key_one,key_two,key_three

# Gemini model endpoint
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent

# Server port
PORT=3000

# Comma-separated origins allowed to call this API: the exact origin(s) your
# frontend is served from. The Vite dev server runs on http://localhost:5173.
# Example for local dev: http://localhost:5173,http://localhost:8000
#
# Required when NODE_ENV=production; the server refuses to start if it's empty.
# In development (NODE_ENV unset or anything other than 'production') it is
# ignored and any origin is allowed.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# ---- LLM reliability & cost controls ----
# All values are integers. An invalid or out-of-range value is clamped to the
# safe bound (or default) with a startup warning instead of crashing. Defaults
# cap worst-case cost and latency without hurting normal answer quality.

# Timeout for a single Gemini API call, in milliseconds.
# Default 30000. Bounds: 1000–120000.
LLM_TIMEOUT_MS=30000

# Overall deadline for the whole /api/coach operation (initial call, retries and
# continuations combined), in milliseconds. After it, no further Gemini calls
# are made. Default 60000. Bounds: 5000–180000.
LLM_TOTAL_TIMEOUT_MS=60000

# Max retries for transient failures (429 / 5xx / network / timeout) per logical
# call, also bounded by LLM_MAX_CALLS_PER_REQUEST below.
# Default 2. Bounds: 0–5.
LLM_MAX_RETRIES=2

# Hard cap on Gemini API calls per /api/coach request, shared by the initial
# call, every retry and every continuation. The ultimate per-request cost
# ceiling. Default 8. Bounds: 1–20.
LLM_MAX_CALLS_PER_REQUEST=8

# Max continuation calls to finish an answer Gemini truncated at the output-token
# limit (long Indic-script answers may need a few). Also bounded by the call
# budget above. Default 4. Bounds: 0–8.
LLM_MAX_CONTINUATIONS=4

# Max output tokens per Gemini call. Kept high because Devanagari/Indic scripts
# use many tokens per character and continuation stitches longer answers
# together; lowering it cuts cost but truncates long answers sooner.
# Default 8192. Bounds: 256–8192.
LLM_MAX_OUTPUT_TOKENS=8192

# ---- Gemini multi-key failover ----
# Only relevant when GEMINI_API_KEY above lists more than one key.

# Clock time (IST) a rate-limited or quota-exhausted key resets at, matching
# Gemini's fixed daily quota reset. Only used when Gemini sends no Retry-After
# header, which always takes precedence. Default 12:30 PM IST.
# Bounds: hour 0–23, minute 0–59.
GEMINI_KEY_RESET_HOUR_IST=12
GEMINI_KEY_RESET_MINUTE_IST=30

# How long a key sits out of rotation after an auth failure (401/403, an invalid
# or revoked key), in milliseconds. Long by default since a bad key won't heal.
# Default 3600000 (1 hour). Bounds: 60000–86400000.
GEMINI_KEY_AUTH_COOLDOWN_MS=3600000

# Rate limiting for POST /api/coach: window in minutes, and max requests per
# window per IP. Leave RATE_LIMIT_MAX_REQUESTS unset for the environment-aware
# default: 60/window in production, 300/window otherwise (a developer iterating
# on the UI can exceed 60 in 15 minutes). An explicit value always wins.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=

# Rate limiting for /api/auth (login, register, refresh, /me, ...), per IP, over
# a fixed 15-minute window independent of RATE_LIMIT_WINDOW_MINUTES above.
# Leave unset for the default: 30/window in production, 300/window otherwise.
# The production value slows online credential guessing; don't raise it casually.
# The development value is higher because this limiter also counts POST /refresh
# and GET /me, which the client calls on every page load.
AUTH_RATE_LIMIT_MAX_REQUESTS=

# ---- Database & auth ----

# SQLite database file (relative to the prisma/ folder). For PostgreSQL use a
# connection string, e.g. postgresql://user:pass@host:5432/dbname
DATABASE_URL="file:./dev.db"

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# How long an access token stays valid. Kept short: the client exchanges it for a
# new one via the refresh token, so this bounds how long a stolen token works
# after a session is revoked.
ACCESS_TOKEN_TTL=15m

# How long a refresh token stays valid before a full login is needed: the
# effective "how long can I stay logged in" setting. Each refresh issues a new
# one, so an active user isn't logged out. Refresh tokens are stored hashed in
# the Session table and can be revoked (logout, "sign out other devices", or an
# admin's "revoke sessions").
REFRESH_TOKEN_TTL_DAYS=7

# Login security: lock an account after this many consecutive failed password
# attempts, for this many minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Transactional email (password reset, demo bookings) ----

# Brevo API key. Get one at https://brevo.com (Settings -> SMTP & API -> API
# Keys); the free tier is enough for a pilot. Brevo verifies a single sender
# address (a plain Gmail works), where other providers need a verified domain.
#
# Unlike GEMINI_API_KEY and JWT_SECRET, leaving it unset doesn't stop the server
# starting: everything except email keeps working, and /auth/forgot-password
# still returns its generic response while logging that the send was skipped.
BREVO_API_KEY=

# The From address on emails, as `Name <address>`. It must be verified in Brevo
# (Senders, Domains & Dedicated IPs -> Senders), or every send fails with a 4xx.
EMAIL_FROM=Teacher Assistant <your-verified-sender@example.com>

# Public URL of the frontend, used to build the reset link
# (<APP_URL>/reset-password/<token>). It must match where the client is served,
# or the link will 404.
APP_URL=http://localhost:5173

# How long a password-reset link stays valid, in minutes. Short, since the link
# is a bearer credential sitting in an inbox.
PASSWORD_RESET_TTL_MINUTES=60

# ---- Google Sign-In ----

# OAuth 2.0 Web application Client ID from the Google Cloud Console (APIs &
# Services -> Credentials). The server checks every Google ID token against it
# as the expected audience.
# Set the same value as VITE_GOOGLE_CLIENT_ID in the client's env. Leaving this
# unset disables Google sign-in (POST /auth/google returns 503); email and
# password sign-in is unaffected.
GOOGLE_CLIENT_ID=

# ---- AI Action Router (assistant) ----
#
# Lets a teacher type "Generate a Class 5 fractions worksheet" and lands them on
# the Generator with the fields pre-filled to review. It never generates, saves
# or deletes anything itself.
#
# Every gate below is OFF by default, so an unconfigured deployment ships an
# inert assistant. Values are parsed leniently (see src/lib/flags.js): an
# unrecognized value falls back to the default with a startup warning. Booleans
# accept true/1/yes/on and false/0/no/off.

# Master kill switch. When false, both assistant endpoints are inert: the catalog
# is empty and every interpret call falls through to the coach. It's the only
# reliable incident control, since the client is a PWA with service-worker
# caching and client-side flags change on a later page load. Flipping this and
# restarting takes effect in under a minute.
# Default: false.
ASSISTANT_ENABLED=false

# Per-action gate; each action descriptor names its own variable, so enabling the
# assistant doesn't enable every capability.
# Default for each: false.
ASSISTANT_ACTION_GENERATE_ASSESSMENT=false
ASSISTANT_ACTION_OPEN_GENERATOR=false

# Comma-separated roles allowed to use the assistant. The catalog is filtered by
# this before the classifier prompt is built.
# Default: teacher
ASSISTANT_ALLOWED_ROLES=teacher

# Comma-separated school codes for staged rollout. Empty means all schools: this
# is a filter, not a gate (ASSISTANT_ENABLED is the gate).
# Default: empty.
ASSISTANT_ALLOWED_SCHOOL_CODES=

# Interpret calls one user may make per day; bounds a single account's cost.
# Exhausting it degrades to normal coach answers, not an error.
# The counter is in process memory (no migration): it resets on restart, and is
# per process, so several instances make the effective ceiling (limit x
# instances), as with the rate limiters' default MemoryStore. Revisit before
# scaling to multiple instances.
# Default 100. Bounds: 1-100000.
ASSISTANT_DAILY_BUDGET_PER_USER=100

# Per-IP request cap for /api/assistant/*, over the same window as
# RATE_LIMIT_WINDOW_MINUTES. A separate bucket from /api/coach, so catalog
# fetches and routing can't use up the coaching budget. Higher than coach since
# these calls are small and frequent.
# Default 120 in production, 600 in development. Bounds: 1-100000.
ASSISTANT_RATE_LIMIT_MAX_REQUESTS=120

# Per-IP request cap for POST /api/resources/generate, over the same window as
# RATE_LIMIT_WINDOW_MINUTES. Generation is the most expensive path in the
# product. 30 per 15 minutes is about two generations a minute sustained. Keyed
# by IP, so a school behind one NAT shares a bucket; raise this first if a staff
# room reports 429s.
# Default 30 in production, 600 in development. Bounds: 1-100000.
RESOURCE_GENERATE_RATE_LIMIT_MAX=30

# ---- Assistant availability guard: router yields to Coach ----
#
# The Coach and the router draw on the same Gemini quota. When the upstream
# starts rate-limiting us, a failing routing call is one the Coach could have
# used, so the router steps back. While the breaker is open, routing spends no
# model calls and every message gets a normal coaching answer; /api/coach is
# never gated by it. State is global to the process and re-closes on the first
# request after the cooldown.
#
# How many rate-limited (HTTP 429) classifications open it.
# Default 5. Bounds: 1-100.
ASSISTANT_BREAKER_429_THRESHOLD=5
# How far back those are counted, in milliseconds.
# Default 60000 (1 minute). Bounds: 1000-3600000.
ASSISTANT_BREAKER_WINDOW_MS=60000
# How long it stays open once tripped, in milliseconds.
# Default 300000 (5 minutes). Bounds: 1000-3600000.
ASSISTANT_BREAKER_COOLDOWN_MS=300000

# ---- Assistant telemetry ----
#
# There's no separate on/off switch. POST /api/assistant/events sits behind the
# same rollout gate as the other endpoints (ASSISTANT_ENABLED, role and school),
# so with the assistant off it writes nothing. A second flag would only allow
# routing to run unmeasured.
#
# Recorded: at most two `Event` rows per routed session, the prefill delivered
# and what the teacher did with it. Counts, ids, enum values and field names
# only, never the utterance, a slot value, generated content, prompt text or
# model output.
#
# Retention: kept 90 days, then pruned by `npm run assistant:prune-events`, which
# deletes only the two assistant_* event types. This value is the script's
# default; pass --days to override it for one run. Run it on a schedule once the
# feature is enabled; there's no in-process sweeper, to keep deletes off the
# single-writer request path. Read current numbers with `npm run assistant:metrics`.
ASSISTANT_EVENT_RETENTION_DAYS=90

# Telemetry writes are also capped per user per day at
# (ASSISTANT_DAILY_BUDGET_PER_USER x 2 + 20), derived from the two-rows-per-session
# ceiling, with no separate flag. Over-budget batches are dropped silently (still
# 204), which can lose a measurement and never costs a teacher anything.

# ---- Assistant LLM tunables (routing, not coaching) ----
#
# Routing runs on a second GeminiService instance with a much tighter budget. The
# coaching values above (30s per call, 60s overall) would make a routing decision
# in front of a text box appear to hang. A timeout here falls through to the
# coach, so the budget must expire long before the teacher gives up.

# Model endpoint used for routing only. A small, fast model suits short
# classification.
# This is a floating alias ("-latest") on purpose: the originally documented
# `gemini-2.5-flash-lite` returned 404 "no longer available to new users", and
# a pinned model is reproducible only until it is retired. Since routing sits
# behind a passthrough, the alias moving costs a quality wobble, not an outage.
# Consequence: an eval baseline recorded against an alias can't be reproduced,
# so the eval runner records the resolved model version with its results.
# models.list can list a model this key can't call; verify with a real
# generateContent request.
ASSISTANT_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-lite-latest:generateContent

# Timeout for a single routing call, in milliseconds.
# Default 3500. Bounds: 1000-10000.
ASSISTANT_LLM_TIMEOUT_MS=3500

# Overall deadline for the whole routing decision; after it the request falls
# through to the coach.
# Default 5000. Bounds: 2000-15000.
ASSISTANT_LLM_TOTAL_TIMEOUT_MS=5000

# Retries for transient routing failures. Lower than coaching, since retrying a
# decision the teacher is waiting on is rarely worth it.
# Default 1. Bounds: 0-2.
ASSISTANT_LLM_MAX_RETRIES=1

# Hard cap on Gemini calls per routing request (initial call plus retries).
# Default 2. Bounds: 1-3.
ASSISTANT_LLM_MAX_CALLS=2

# Max output tokens for a routing response. A classification is a small JSON
# object, so a large cap only pays for unused tokens.
# Default 512. Bounds: 128-1024.
ASSISTANT_LLM_MAX_OUTPUT_TOKENS=512

# ---- Multimodal attachments (Coach: image/PDF upload) ----------------------
#
# Lets a teacher attach a JPEG/PNG/WEBP image or a PDF to a Coach question
# ("Solve Question 5", "Summarize this chapter"). POST /api/coach/attachment is
# its own endpoint and shares nothing with /api/assistant/*. Files are never
# written to disk or the database; each upload is held in memory for the request
# and then discarded.
#
# Every gate below defaults OFF, and ATTACHMENTS_ENABLED is the reliable incident
# control (same PWA caching reasoning as ASSISTANT_ENABLED).

# Master kill switch. When false, POST /api/coach/attachment returns 503 for
# everyone and never buffers an upload. Text and voice Coach are unaffected.
# Default: false.
ATTACHMENTS_ENABLED=false

# Comma-separated school codes for staged rollout. Empty means all schools: a
# filter, not a gate (ATTACHMENTS_ENABLED is the gate).
# Default: empty.
ATTACHMENT_ALLOWED_SCHOOL_CODES=

# Attachment requests one user may make per day. The most expensive call shape
# (image/PDF tokens), so lower than the router's budget. In process memory, so it
# resets on restart and is per process (see ASSISTANT_DAILY_BUDGET_PER_USER).
# Default 20. Bounds: 1-100000.
ATTACHMENT_DAILY_BUDGET_PER_USER=20

# Max upload size, in megabytes, for both the multer limit and the byte-level
# check in lib/fileValidation.js.
# Default 8. Bounds: 1-20.
ATTACHMENT_MAX_FILE_SIZE_MB=8

# Max estimated PDF page count (a lightweight marker count, not a real parse; see
# lib/fileValidation.js). A byte cap alone doesn't bound Gemini's per-page cost,
# since a compressed multi-hundred-page PDF can be small. An unknown count is
# allowed: this is a cost guard, not a correctness gate.
# Default 30. Bounds: 1-500.
ATTACHMENT_MAX_PDF_PAGES=30

# Max files in one message, sent to Gemini together in one call (see
# src/attachments/describeAttachment.js). Applies to multer's limit and the batch
# check in lib/fileValidation.js.
# Default 5. Bounds: 1-10.
ATTACHMENT_MAX_FILES=5

# Max combined size of all files in one message, in megabytes. Separate from
# ATTACHMENT_MAX_FILE_SIZE_MB x ATTACHMENT_MAX_FILES: Gemini's inline-data ceiling
# applies to the whole request and base64 adds ~33%. 15MB raw stays under the
# ~20MB inline ceiling after that overhead.
# Default 15. Bounds: 1-40.
ATTACHMENT_MAX_TOTAL_SIZE_MB=15

# Per-IP request cap for POST /api/coach/attachment, over the same window as
# RATE_LIMIT_WINDOW_MINUTES. A separate bucket from /api/coach, since attachment
# requests cost far more.
# Default 20 in production, 300 in development. Bounds: 1-100000.
ATTACHMENT_RATE_LIMIT_MAX_REQUESTS=20

# ---- Attachment LLM tunables (multimodal, not coaching or routing) --------
#
# A third GeminiService instance (see index.js). Multimodal calls are slower and
# costlier than the others, so they get their own timeout, retry and cost budget.

# Model endpoint for attachment requests. Defaults to GEMINI_ENDPOINT (the
# coaching model): Gemini 2.5 Flash handles image and PDF input natively.
ATTACHMENT_GEMINI_ENDPOINT=

# Timeout for a single attachment call, in milliseconds.
# Default 30000. Bounds: 1000-120000.
ATTACHMENT_LLM_TIMEOUT_MS=30000

# Overall deadline for the whole attachment request (initial call plus retries),
# in milliseconds.
# Default 60000. Bounds: 5000-180000.
ATTACHMENT_LLM_TOTAL_TIMEOUT_MS=60000

# Max retries for transient failures (429/5xx/network/timeout).
# Default 2. Bounds: 0-5.
ATTACHMENT_LLM_MAX_RETRIES=2

# Hard cap on total Gemini calls per attachment request.
# Default 8. Bounds: 1-20.
ATTACHMENT_LLM_MAX_CALLS_PER_REQUEST=8

# Max output tokens per attachment response.
# Default 4096. Bounds: 256-8192.
ATTACHMENT_LLM_MAX_OUTPUT_TOKENS=4096

# ---------------------------------------------------------------------------
# HELP & SUPPORT (bug reports + feedback) — see docs/help-support-architecture.md
# ---------------------------------------------------------------------------
#
# Lets a teacher report a bug or send feedback in the app
# (POST /api/support/tickets). Makes no LLM call, so there's no daily budget; the
# per-IP SUPPORT_RATE_LIMIT_MAX_REQUESTS bounds it. Defaults OFF, and
# HELP_SUPPORT_ENABLED is the reliable incident control.

# Master kill switch. When false, POST /api/support/tickets returns 503 for
# everyone. Existing thumbs up/down feedback is unaffected.
# Default: false.
HELP_SUPPORT_ENABLED=false

# Comma-separated school codes for staged rollout. Empty means all schools: a
# filter, not a gate (HELP_SUPPORT_ENABLED is the gate).
# Default: empty.
HELP_SUPPORT_ALLOWED_SCHOOL_CODES=

# Requests to POST /api/support/tickets one IP may make per rate-limit window.
# Default: 20 in production, 300 in development. Bounds: 1-100000.
SUPPORT_RATE_LIMIT_MAX_REQUESTS=20

# ---------------------------------------------------------------------------
# AI LEARNING REPRESENTATION SYSTEM — see docs/learning-representation-system-adr.md
# ---------------------------------------------------------------------------
#
# Lets a teacher request a structured visual (diagram, table, timeline...)
# alongside a Coach answer (POST /api/coach/learning-representation). Defaults
# OFF, and LEARNING_REPRESENTATION_ENABLED is the reliable incident control.

# Master kill switch. When false, the endpoint always returns its inert
# {representation: "verbal_explanation", data: null} response. Coach answers are
# unaffected.
# Default: false.
LEARNING_REPRESENTATION_ENABLED=false

# Comma-separated school codes for staged rollout. Empty means all schools: a
# filter, not a gate (LEARNING_REPRESENTATION_ENABLED is the gate).
# Default: empty.
LEARNING_REPRESENTATION_ALLOWED_SCHOOL_CODES=

# Requests one user may make per day. Each costs up to two Gemini calls
# (classify, then render), so this sits between ASSISTANT_DAILY_BUDGET_PER_USER
# and ATTACHMENT_DAILY_BUDGET_PER_USER. Default: 50. Bounds: 1-100000.
LEARNING_REPRESENTATION_DAILY_BUDGET_PER_USER=50

# Requests to POST /api/coach/learning-representation one IP may make per
# rate-limit window. Default: 60 in production, 600 in development. Bounds: 1-100000.
LEARNING_REPRESENTATION_RATE_LIMIT_MAX_REQUESTS=60

# ---------------------------------------------------------------------------
# CLASSROOM MODE — see docs/classroom-mode.md
# ---------------------------------------------------------------------------
#
# A chat mode a teacher turns on from the "+" button in the Composer. While on, a
# question with a teachable topic also produces classroom materials (lesson
# plan, worksheet, quiz, homework, exit ticket) beside the coaching answer.
#
# One teacher action fans out into several model calls (a coaching answer, a
# planner call, one generation per artifact), so CLASSROOM_MODE_ENABLED is a
# spend control as well as a kill switch, and the only reliable one: the client's
# VITE_CLASSROOM_MODE_ENABLED is baked in at build time and may be stale on
# already-loaded PWA clients.

# Master kill switch. When false, /api/coach never runs the planner or attaches
# classroom materials, whatever the client sends.
# Default: false.
CLASSROOM_MODE_ENABLED=false

# Comma-separated school codes for staged rollout. Empty means all schools: a
# filter, not a gate (CLASSROOM_MODE_ENABLED is the gate).
# Default: empty.
CLASSROOM_MODE_ALLOWED_SCHOOL_CODES=

# ---------------------------------------------------------------------------
# NOTIFICATION SYSTEM — see docs/notification-system-plan.md
# ---------------------------------------------------------------------------
#
# Bell icon and notification center (admin announcements, plus system/AI
# notifications like "your worksheet is ready"), with realtime delivery over
# Socket.IO to online users.
#
# Master kill switch. When false, every /api/notifications route returns 503 and
# the Socket.IO handshake rejects every connection: no REST, no realtime, no DB
# rows. Existing features are unaffected.
# Default: false.
NOTIFICATIONS_ENABLED=false

# Per-IP request cap for POST /api/notifications (send/broadcast only; the
# frequent, self-scoped GET/PATCH routes stay under the general
# RATE_LIMIT_MAX_REQUESTS limiter), over the same window as RATE_LIMIT_WINDOW_MINUTES.
# Default: 20 in production, 300 in development. Bounds: 1-100000.
NOTIFICATIONS_SEND_RATE_LIMIT_MAX_REQUESTS=20

# ---------------------------------------------------------------------------
# CLASSROOM MANAGEMENT — see docs/classroom-feature-plan.md
# ---------------------------------------------------------------------------
#
# A teacher-first workspace: My Classes / Students / Attendance / Fees / Reports.
# Not CLASSROOM_MODE_ENABLED above, which is an unrelated AI chat feature.
# Isolation is per teacher, not per school: every route filters on the caller's
# own teacherId, so no admin role sees another teacher's data in V1.

# Master kill switch. When false, every /api/classroom/* route returns 503 and
# touches no table. Existing features are unaffected.
# Default: false.
CLASSROOM_MANAGEMENT_ENABLED=false

# Comma-separated school codes for staged rollout. Empty means all schools: a
# filter, not a gate (CLASSROOM_MANAGEMENT_ENABLED is the gate).
# Default: empty.
CLASSROOM_MANAGEMENT_ALLOWED_SCHOOL_CODES=

# Per-IP request cap for /api/classroom/*, over the same window as
# RATE_LIMIT_WINDOW_MINUTES. Classroom writes are frequent but cheap, closer to
# /resources CRUD than an AI call, so the ceiling is generous.
# Default: 300 in production, 1200 in development. Bounds: 1-100000.
CLASSROOM_MANAGEMENT_RATE_LIMIT_MAX_REQUESTS=300

# --- Teacher Attendance (docs/feature-teacher-attendance-implementation-plan.md) ---
#
# A teacher's own check-in/check-out (location and time), scored against school
# timing rules and reviewed by their school's Principal. Not
# CLASSROOM_MANAGEMENT_ENABLED above, which is student attendance.

# Master kill switch. When false, every /api/teacher-attendance/* route returns
# 503 and touches no table.
# Default: false.
TEACHER_ATTENDANCE_ENABLED=false

# Comma-separated school codes for staged rollout. Empty means all schools: a
# filter, not a gate (TEACHER_ATTENDANCE_ENABLED is the gate).
# Default: empty.
TEACHER_ATTENDANCE_ALLOWED_SCHOOL_CODES=

# Per-IP request cap for /api/teacher-attendance/*, like
# CLASSROOM_MANAGEMENT_RATE_LIMIT_MAX_REQUESTS: a check-in or check-out is a
# small, cheap write.
# Default: 300 in production, 1200 in development. Bounds: 1-100000.
TEACHER_ATTENDANCE_RATE_LIMIT_MAX_REQUESTS=300

# --- Structured Question Model (Generator v2, docs/generator-v2-plan.md) ----
#
# Gates only the 3 new Quiz/Worksheet Generator question types (descriptive,
# fill_blank, match) and the server-side rule that re-renders content from
# structured questions on POST /resources and PATCH /resources/:id. The existing
# mcq/true_false/short_answer/mixed behavior and every other /resources route are
# unaffected.
#
# Master kill switch. When false, requesting a new question type from
# POST /resources/generate or /resources/generate-set returns
# 503 STRUCTURED_QUESTIONS_DISABLED. The client's VITE_STRUCTURED_QUESTIONS_ENABLED
# only hides the new picker options on a cached PWA build.
# Default: false.
STRUCTURED_QUESTIONS_ENABLED=false

# ---------------------------------------------------------------------------
# MOBILE PUSH — see docs/mobile-app-plan.md
# ---------------------------------------------------------------------------
#
# OS-level push (background or killed app) for the mobile app, on top of the
# in-app and realtime Notification System. A separate gate layered on
# NOTIFICATIONS_ENABLED: that decides whether a Notification is created at all,
# this one only whether POST/DELETE /api/notifications/device-tokens accept
# requests and whether a created notification also triggers an Expo push.

# Master kill switch for push. When false, the device-token routes 503 and push
# dispatch is a no-op (no DeviceToken read, no Expo call). Existing notification
# behavior is unaffected.
# Default: false.
MOBILE_PUSH_ENABLED=false

# Optional Expo "Enhanced Push Security" access token (Expo dashboard -> project
# -> Credentials). Push works without it, just without that extra bearer credential.
EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# SCHEDULE A CALL
# ---------------------------------------------------------------------------
#
# Public demo-booking flow for schools and organizations. Availability is a fixed
# rule (working days, hours and slot length in one timezone), not a calendar
# integration.

# Master kill switch. When false, every /api/schedule-demo/* route returns 503
# and touches no table.
# Default: false.
DEMO_BOOKING_ENABLED=false

# The single timezone every slot is booked and displayed in (see
# lib/demoBookingConfig.js); times aren't converted per visitor.
# Default: Asia/Kolkata.
DEMO_BOOKING_TIMEZONE=Asia/Kolkata

# Comma-separated ISO weekday numbers (1=Monday..7=Sunday) that are bookable.
# Default: 1,2,3,4,5 (Monday-Friday).
DEMO_BOOKING_WORK_DAYS=1,2,3,4,5

# Daily booking window, 24h "HH:MM", in DEMO_BOOKING_TIMEZONE.
# Defaults: 10:00 to 17:00.
DEMO_BOOKING_START_TIME=10:00
DEMO_BOOKING_END_TIME=17:00

# Length of one bookable slot, in minutes.
# Default: 30. Bounds: 5-240.
DEMO_BOOKING_SLOT_MINUTES=30

# How many days ahead a visitor may book.
# Default: 21. Bounds: 1-90.
DEMO_BOOKING_LOOKAHEAD_DAYS=21

# Minimum notice before a slot's start time, to block last-minute bookings.
# Default: 12. Bounds: 0-240.
DEMO_BOOKING_MIN_NOTICE_HOURS=12

# Internal address that gets a "new booking" email through Brevo (see
# BREVO_API_KEY above). Leave unset to skip it; bookings succeed either way.
# Default: empty.
DEMO_BOOKING_ADMIN_EMAIL=

# Per-IP request cap for POST/PATCH /api/schedule-demo/bookings*: a public,
# unauthenticated write with no per-user budget, like SUPPORT_RATE_LIMIT_MAX_REQUESTS.
# Default: 5 in production, 100 in development. Bounds: 1-100000.
DEMO_BOOKING_RATE_LIMIT_MAX_REQUESTS=5
