// Prisma schema for the Teacher Assistant.
// SQLite for the pilot; moving to PostgreSQL means changing the datasource provider and DATABASE_URL and re-running migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A school is the tenant boundary. The `code` picks the tenant at sign-UP;
// sign-in needs only an email, so a returning teacher never has to know it.
model School {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  district  String?
  state     String?
  createdAt DateTime @default(now())

  users                  User[]
  queries                Query[]
  events                 Event[]
  resources              Resource[]
  supportTickets         SupportTicket[]
  // Classroom Management (docs/classroom-feature-plan.md). Denormalized beside SchoolClass.teacherId and never used
  // for row-level access (queries filter on teacherId only); reserved for a possible school-admin rollup, unused in V1.
  schoolClasses          SchoolClass[]
  conversations          Conversation[]
  // Teacher Attendance (docs/feature-teacher-attendance-implementation-plan.md)
  attendanceConfig       SchoolAttendanceConfig?
  teacherAttendances     TeacherAttendance[]
  holidays               SchoolHoliday[]
  attendanceActivityLogs TeacherAttendanceActivityLog[]
}

// Roles: teacher | school_admin | resource_person | super_admin
// Identity is `email`, not `name`: teacher names collide within a school, and email unifies manual sign-up with
// Google sign-in, which always supplies a verified one. `name` is a display field (Manage table, app header, exam
// letterhead) and isn't unique.
// `status` gates sign-in. New sign-ups are `active`; `pending` and `rejected` are set by an admin and block sign-in.
model User {
  id               String    @id @default(cuid())
  school           School    @relation(fields: [schoolId], references: [id])
  schoolId         String
  name             String
  email            String
  displayName      String?
  preferences      String? // JSON string of teacher preferences (defaults + responseStyle + avatar)
  role             String    @default("teacher")
  // Set for accounts created through the email+password path. Null for
  // Google-only accounts, which have no local secret to verify.
  passwordHash     String?
  // Google's stable subject claim (`sub`) from a verified ID token. Indexed
  // because Google sign-in looks an identity up across every school at once.
  googleSub        String?
  status           String    @default("active") // active | pending | rejected | suspended
  // When the status last changed to or from suspended. A token issued before this instant is refused (see middleware/auth.js).
  statusChangedAt  DateTime?
  // Legacy: the pre-email name+PIN credential. Retained so the migration
  // never has to drop a column; no current code path reads or writes it.
  pinHash          String?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLogin        DateTime?
  createdAt        DateTime  @default(now())

  queries                Query[]
  feedback               Feedback[]
  events                 Event[]
  sessions               Session[]
  resources              Resource[]
  passwordResetTokens    PasswordResetToken[]
  supportTickets         SupportTicket[]
  supportNotes           SupportNote[]
  profilePicture         ProfilePicture?
  notifications          Notification[]
  // OS-level push registrations (docs/mobile-app-plan.md): one row per installed-app instance, not per user (see DeviceToken).
  deviceTokens           DeviceToken[]
  // Classroom Management (docs/classroom-feature-plan.md): a teacher's own classes. Every class, student, attendance and
  // fee row is scoped to teacherId, never schoolId, so one teacher never sees another's even within a school.
  schoolClasses          SchoolClass[]
  conversations          Conversation[]
  // Teacher Attendance (docs/feature-teacher-attendance-implementation-plan.md): this teacher's own check-in/check-out
  // days, and (for a school_admin) the review actions taken on other teachers' days.
  teacherAttendances     TeacherAttendance[]
  attendanceReviews      TeacherAttendanceReview[]
  attendanceActivityLogs TeacherAttendanceActivityLog[]

  // Email is unique within a school. The same email may hold accounts at several schools, so sign-in looks up by
  // email across schools and asks the user to choose when several match.
  @@unique([schoolId, email])
  @@index([googleSub])
}

// A custom uploaded profile picture, in its own table so a normal prisma.user.findMany()/findUnique() never pulls
// image bytes into memory; only code that explicitly selects `data` (the serving route) does. One row per user
// (upsert on upload, deleted on removal); the row's presence is the "has a custom photo" flag. publicUser() in
// routes/auth.js reads only `updatedAt` to build a cache-busted avatarUrl.
model ProfilePicture {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  data      Bytes
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A single-use, time-limited password-reset token. Like Session, the raw token goes out in the email and only its
// SHA-256 hash is stored (hashToken in middleware/auth.js), so a database leak can't be replayed into takeovers.
// `usedAt` makes redemption single-use even within the expiry window.
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A refresh-token session, so a login can be revoked server-side instead of only expiring after TOKEN_TTL. Only the
// SHA-256 hash of the raw token is stored. It's rotated on every /auth/refresh; `replacedBy` links a session to its
// successor, so a reused (already rotated-out) token can be detected as likely theft.
model Session {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  lastUsedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// Every coaching request is persisted for history + analytics.
model Query {
  id                 String   @id @default(cuid())
  user               User?    @relation(fields: [userId], references: [id])
  userId             String?
  school             School?  @relation(fields: [schoolId], references: [id])
  schoolId           String?
  queryText          String
  language           String   @default("en")
  context            String? // JSON string of { grade, subject, classroomType, issueType }
  responseText       String
  responseTimeMs     Int?
  finishReason       String?
  // Classroom Mode's plan for this turn as a JSON string, NULL for ordinary questions (docs/classroom-mode.md). Nullable
  // and additive, so nothing reading a Query needs to know about it. It stores the plan (topic, grade, subject,
  // language, which artifacts fit), never the generated artifacts, which are saved only by an explicit teacher action.
  classroomPlan      String?
  // The artifacts Classroom Mode generated for this turn, as JSON { artifactKind: markdown } (docs/classroom-mode.md).
  // NULL for ordinary questions. Never select this in a list query: it holds up to five documents, and a 20-row
  // history would move hundreds of KB. routes/queries.js uses an explicit `select`, and fetches one turn's artifacts on demand.
  classroomArtifacts String?
  createdAt          DateTime @default(now())
  // Teacher-set display label for a history entry ("Rename chat"). NULL if never renamed, in which case the client
  // shows `queryText`. `queryText` is never edited, since it's what reopening the entry replays as the user's message.
  title              String?
  // "Pin chat". A plain boolean, not nullable, so existing rows backfill to the same unpinned default as new ones.
  pinned             Boolean  @default(false)
  // Groups the turns of one chat thread. Each turn is still its own row; the client sends the same id with every turn of
  // a thread. NULL for rows saved before threads existed, which stay one-turn chats keyed by their own id.
  conversationId     String?

  feedback Feedback[]

  @@index([userId])
  @@index([schoolId])
  @@index([createdAt])
  @@index([userId, conversationId])
}

// Documents an existing table, not a new feature. This model (and Message) existed only in the live dev.db's
// applied-migrations history: the migration that created them (20260720193726) was applied but its file was never
// committed, so the schema never described them. Nothing reads or writes Conversation or Message; they look like an
// abandoned prototype. They're documented as-is so the schema matches the database and future migrations don't
// drop them. Check whether they should be reused or removed before building on them.
model Conversation {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId   String
  title      String?
  language   String    @default("en")
  classLevel String?
  subject    String?
  topic      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  messages   Message[]

  @@index([userId])
  @@index([schoolId])
  @@index([createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           String
  content        String
  language       String?
  classLevel     String?
  subject        String?
  topic          String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([conversationId, role, createdAt])
  @@index([createdAt])
}

// Thumbs up/down on a response.
model Feedback {
  id        String   @id @default(cuid())
  query     Query    @relation(fields: [queryId], references: [id])
  queryId   String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  rating    String // helpful | not_helpful
  createdAt DateTime @default(now())

  @@index([queryId])
}

// Generic analytics events (voice_used, etc.).
model Event {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  school    School?  @relation(fields: [schoolId], references: [id])
  schoolId  String?
  type      String
  metadata  String? // JSON string
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

// A teacher-owned saved resource: the store for "My Library" and the Lesson Plan Workspace. Private to its owner.
// `structured` is a JSON string (the lesson-plan fields for type = lesson_plan), like preferences and context.
// `sourceQueryId` is a soft link to the originating history entry, not a foreign key, so clearing history never cascades to saved resources.
model Resource {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  school        School?  @relation(fields: [schoolId], references: [id])
  schoolId      String?
  type          String   @default("general") // lesson_plan | classroom_activity | assessment | explanation | general
  title         String
  grade         String?
  subject       String?
  language      String   @default("en")
  content       String   @default("") // markdown body
  structured    String? // JSON string of structured lesson-plan fields
  sourceQueryId String? // soft reference to the originating Query (no FK)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@index([createdAt])
}

// Help & Support: bug reports and feedback, both filed from the "Need Help?" entry point
// (docs/help-support-architecture.md). One model with a `type` discriminator (bug | feedback), like Resource holds
// several kinds, since they share every column and differ only in which are required. Contact Support creates no
// row (it's a client-side WhatsApp link).
// `context` is a JSON string (like User.preferences and Query.context) of auto-captured, non-sensitive diagnostics
// (route, build id, browser, requestId, ...), loosely typed so a new field needs no migration. It never carries the AI prompt/answer or a screenshot.
model SupportTicket {
  id          String   @id @default(cuid())
  type        String // bug | feedback
  category    String? // closed vocabulary, different per type — see routes/support.js
  description String   @default("") // required for bug, optional for feedback (enforced in routes/support.js)
  status      String   @default("open") // open | triaged | resolved | wont_fix
  user        User?    @relation(fields: [userId], references: [id])
  userId      String?
  school      School?  @relation(fields: [schoolId], references: [id])
  schoolId    String?
  context     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notes SupportNote[]

  @@index([status])
  @@index([type])
  @@index([schoolId])
  @@index([createdAt])
  // Indexed for the admin inbox's filtering and search.
  @@index([category])
  @@index([userId])
}

// A single admin-configurable runtime override, e.g. a feature-flag toggle from Admin Settings > Feature Management
// (see lib/systemSettings.js). No row means "no override", and the caller falls back to the env-var default.
// `updatedById` is a soft reference to the acting admin (not a FK, like Resource.sourceQueryId); the audit trail is
// the Event row the same write creates.
model SystemSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// One notification per recipient (fan-out on write, not a broadcast plus read-receipt join), as Event does per user
// per occurrence. "My unread count" is one indexed WHERE, and pilot-scale fan-out is cheap. createMany() makes a
// broadcast one INSERT (see lib/notificationService.js). See docs/notification-system-plan.md.
model Notification {
  id          String    @id @default(cuid())
  recipient   User      @relation(fields: [recipientId], references: [id])
  recipientId String
  // Closed vocabulary: lib/notificationTypes.js (server) and NOTIFICATION_TYPES in the client's config.ts.
  type        String
  title       String
  message     String
  // Relative in-app path to open on click (e.g. "/library/<id>"), or null. Never an absolute URL.
  link        String?
  read        Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  // Soft reference to the sending admin, or null for a system/AI notification. Not a FK, like SystemSetting.updatedById:
  // this row is the durable record, and an admin's account is never blocked from deletion by rows they sent.
  // Denormalized with the name and role so a broadcast needs no join to render "Sent by <name> (<role>)".
  senderId    String?
  senderName  String?
  senderRole  String?
  // Optional extra context as a JSON string, same convention as
  // Query.context / SupportTicket.context.
  metadata    String?

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
  @@index([type])
}

// OS-level push registration (docs/mobile-app-plan.md): one row per installed mobile app instance, not per user, so
// one teacher on two phones has two rows. `token`, not `userId`, is the unique key, so re-registering the same
// installation under another account (a shared or reset device) reassigns the row (see the upsert in
// routes/notifications.js). notificationService.js reads these rows to decide who gets an Expo push alongside the
// realtime Socket.IO emit, never instead of the in-app list or the bell.
model DeviceToken {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  // The Expo push token (e.g. "ExponentPushToken[xxxxxxxx]"), not a raw FCM/APNs token: Expo's push service is the
  // delivery mechanism (docs/mobile-app-plan.md), and this is what sendPushNotificationsAsync() takes.
  token      String   @unique
  // 'ios' | 'android'. Informational only today; kept like Session.userAgent for a possible "signed-in devices" screen.
  platform   String
  createdAt  DateTime @default(now())
  // Bumped on every successful re-registration (app launch, token refresh). Not read yet; the place to add a
  // staleness sweep later without a schema change.
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// An admin's internal note on a SupportTicket. Never exposed to the ticket's submitter: no teacher-facing endpoint
// returns these rows. Append-only from the UI (no edit or delete yet), so a note can be candid without risk of the filer seeing it.
model SupportNote {
  id        String        @id @default(cuid())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  ticketId  String
  author    User          @relation(fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

// Classroom Management (docs/classroom-feature-plan.md): My Classes, Students, Attendance, Fees, Reports.
// Isolation is per teacher (teacherId), not per school: two teachers at one school are as isolated as two at different
// schools. Every route filters on `teacherId: req.user.id` with no cross-teacher visibility in V1 (see routes/classroom.js
// and test/classroom-tenant-isolation.test.js).
// Not the unrelated "Classroom Mode" AI chat feature (Query.classroomPlan/classroomArtifacts, docs/classroom-mode.md),
// which has no classes, students, attendance or fees.

// A teacher's own class (e.g. "Class 5-A"), owned by exactly one teacher like Resource. There's no shared "the
// school's 5-A" entity: two teachers at one school each create and see only their own SchoolClass rows.
model SchoolClass {
  id        String   @id @default(cuid())
  teacher   User     @relation(fields: [teacherId], references: [id])
  teacherId String
  // Denormalized beside teacherId, like Resource.schoolId. Never used for row-level access; reserved for a possible school-admin rollup.
  school    School?  @relation(fields: [schoolId], references: [id])
  schoolId  String?
  name      String // "Class 5-A"
  grade     String? // reuses the GRADES vocabulary where useful, free text otherwise
  section   String? // "A", "B" — split out since Attendance/Reports may filter by it later
  // Expected monthly fee for each active student, in whole rupees (no paise). Null until a teacher sets one. The first
  // time a payment is recorded for a student and period (the PATCH that creates the FeeRecord), this is copied into the
  // row's `expectedAmount`, so editing feeAmount later affects only untouched periods. See docs/fee-tracking-amounts-plan.md.
  feeAmount Int?
  archived  Boolean  @default(false) // soft-delete: a class with attendance history is never hard-deleted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students Student[]

  @@index([teacherId])
  @@index([teacherId, archived])
}

// A student belongs to one class (and so one teacher). Minimal today (name only); `details` is an open JSON string
// (like User.preferences) for roll number, parent contact, DOB and so on without a migration.
model Student {
  id          String      @id @default(cuid())
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  classId     String
  // Denormalized like SchoolClass.teacherId: ownership checks filter on this directly rather than joining through SchoolClass, as Resource.userId does.
  teacherId   String
  name        String
  rollNumber  String? // optional now; first concrete field beyond `details`
  active      Boolean     @default(true) // soft-delete: preserves attendance/fee history
  details     String? // JSON string — future fields (contact, DOB, guardian) land here first
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  attendance AttendanceRecord[]
  feeRecords FeeRecord[]

  @@index([classId])
  @@index([teacherId])
}

// One row per student per calendar day (fan-out on write, like Event/Notification). A student with no row for a date
// is unmarked; "unmarked" is never a stored status (see routes/classroom.js). Month views and percentages are computed
// by aggregation, not stored, so they can't drift from a stale rollup.
model AttendanceRecord {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id])
  studentId String
  // Denormalized, same reasoning as Student.teacherId — every list/summary
  // query is teacher-scoped and this avoids a join through Student→SchoolClass.
  teacherId String
  classId   String
  date      DateTime // stored at UTC midnight for the calendar date
  status    String // "present" | "absent" — closed vocabulary, see routes file
  markedAt  DateTime @default(now())

  // One mark per student per day: the database guarantees "today's attendance" is unambiguous, and a re-mark is an update.
  @@unique([studentId, date])
  @@index([classId, date])
  @@index([teacherId, date])
}

// One row per student per month: a payment record, not a full ledger. One row per period (like AttendanceRecord)
// rather than a mutable field on Student, so previous months come for free.
model FeeRecord {
  id             String    @id @default(cuid())
  student        Student   @relation(fields: [studentId], references: [id])
  studentId      String
  teacherId      String
  classId        String
  // "2026-08": a string, not a DateTime, since a fee period is a whole calendar month and a DateTime would add timezone ambiguity.
  period         String
  status         String    @default("pending") // "paid" | "partial" | "pending" — derived server-side from amount vs expectedAmount, never set directly by the client (see routes/classroom.js)
  amount         Int? // amount actually paid so far this period, in whole rupees; null/0 = nothing paid yet
  // Snapshot of SchoolClass.feeAmount taken when this period's record is created (the upsert `create` branch in
  // routes/classroom.js), fixed afterwards so a past month's "amount pending" doesn't change. Null if the class had no
  // feeAmount then, which falls back to a paid/pending read.
  expectedAmount Int?
  paidAt         DateTime? // set to the time of the most recent payment update
  note           String?
  updatedAt      DateTime  @updatedAt

  @@unique([studentId, period])
  @@index([classId, period])
  @@index([teacherId, period])
}

// Teacher Attendance (docs/feature-teacher-attendance-implementation-plan.md).
// These models record a teacher's own attendance, reviewed by their school's Principal (role = school_admin). Not the
// Classroom Management models above, which record the student attendance a teacher marks for their class.

// One row per school, holding only what this feature needs, separate from School so a school with the feature off
// carries no attendance columns and School's shape is unchanged.
model SchoolAttendanceConfig {
  id       String @id @default(cuid())
  school   School @relation(fields: [schoolId], references: [id])
  schoolId String @unique

  openTime           String // "09:00", 24h IST wall-clock time
  closeTime          String // "16:00"
  checkinWindowStart String // "08:30"
  checkinWindowEnd   String // "10:00"
  // Comma-separated day-of-week numbers the school is closed each week, JS Date.getDay() style (0=Sunday..6), like
  // TEACHER_ATTENDANCE_ALLOWED_SCHOOL_CODES. Default "0" (Sunday); "0,6" adds Saturday. Checked with SchoolHoliday
  // before a check-in is allowed (see isWeeklyOff() in lib/teacherAttendance.js).
  weeklyOffDays      String @default("0")

  lateGraceMinutes           Int @default(10)
  halfDayThresholdPercent    Int @default(50)
  fullDayGraceMinutes        Int @default(15)
  earlyDepartureGraceMinutes Int @default(15)

  geofenceLat          Float
  geofenceLon          Float
  geofenceRadiusMeters Int   @default(180)

  repeatPatternThreshold  Int @default(3)
  repeatPatternWindowDays Int @default(30)

  // The checkout reminder's timing (lib/teacherAttendanceReminder.js), a per-school setting a Principal can change.
  reminderMinutesBeforeClose Int @default(15)
  reminderMinutesAfterClose  Int @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per teacher per calendar date. The raw check-in/check-out evidence is the source of truth; status and
// every derived field are recomputed by the shared functions in lib/teacherAttendance.js, never hand-written by a
// route (as with classroomAttendance.js).
model TeacherAttendance {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id])
  userId   String
  school   School @relation(fields: [schoolId], references: [id])
  schoolId String
  date     String // "YYYY-MM-DD", IST calendar date

  checkInAt             DateTime?
  checkInLat            Float?
  checkInLon            Float?
  checkInAccuracyMeters Float?
  checkInDistanceMeters Float?
  checkInDeviceId       String?

  checkOutAt             DateTime?
  checkOutLat            Float?
  checkOutLon            Float?
  checkOutAccuracyMeters Float?
  checkOutDistanceMeters Float?
  checkOutDeviceId       String?

  // present | late | half_day | absent | on_leave | on_duty | pending_regularization | flagged_review
  status                String
  lateMinutes           Int?
  earlyDepartureMinutes Int?
  workingMinutes        Int?
  shortfallMinutes      Int?

  // Free text, not an enum: the official leave/duty category list is still pending from the department.
  leaveOrDutyCategory String?
  leaveOrDutyReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews TeacherAttendanceReview[]

  // One attendance row per teacher per day — the DB enforces the invariant
  // routes rely on, mirroring AttendanceRecord's @@unique([studentId, date]).
  @@unique([userId, date])
  @@index([schoolId, date])
}

// Append-only audit trail. A Principal action never overwrites TeacherAttendance's original fields; it adds a row
// here and then updates the derived status. Like Session, nothing is deleted.
model TeacherAttendanceReview {
  id               String            @id @default(cuid())
  attendance       TeacherAttendance @relation(fields: [attendanceId], references: [id])
  attendanceId     String
  reviewedBy       User              @relation(fields: [reviewedByUserId], references: [id])
  reviewedByUserId String
  // approve | correct_checkin | correct_checkout | mark_on_leave |
  // mark_on_duty | reject — see lib/teacherAttendanceSchema.js's REVIEW_ACTIONS.
  action           String
  previousStatus   String
  newStatus        String
  // Mandatory, enforced by teacherAttendanceSchema.js's zod schema: every approval or correction needs a written reason.
  reason           String
  createdAt        DateTime          @default(now())

  @@index([attendanceId])
}

// A one-off non-working day for a school: department-set (the yearly calendar) or Principal-set (an emergency closure).
model SchoolHoliday {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id])
  schoolId  String
  date      String // "YYYY-MM-DD"
  reason    String
  source    String // "department" | "principal_emergency"
  createdAt DateTime @default(now())

  @@unique([schoolId, date])
}

// Every attendance-related event, whether or not it changed a TeacherAttendance row: login, check-in, check-out, a
// blocked attempt, a correction, a settings change, a reminder. Separate from TeacherAttendanceReview (Principal
// corrections only), since most rows here were never a "review". See docs/feature-teacher-attendance-implementation-plan.md.
model TeacherAttendanceActivityLog {
  id       String @id @default(cuid())
  school   School @relation(fields: [schoolId], references: [id])
  schoolId String
  user     User   @relation(fields: [userId], references: [id])
  userId   String // whose day this event is about

  // Set only when different from userId (e.g. an admin correcting someone else's record). A plain id, not a relation:
  // this is a log, never queried as "every row this admin performed".
  performedBy String?

  // login | check_in | check_out | check_in_blocked | check_out_blocked | missing_checkout | correction | mark_on_leave |
  // mark_on_duty | holiday_changed | settings_changed | reminder_sent
  action String

  result         String? // short human-readable summary, e.g. "63m from school" or "blocked, 410m away"
  lat            Float?
  lon            Float?
  distanceMeters Float?
  // JSON, only for actions that need extra detail (old/new values on a
  // correction or settings change).
  metadata       String?

  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
}

// Schedule a Call: a public visitor's request to book a demo call with the SarasTech team.
// No School/User relation, unlike every other model, since the visitor hasn't signed up. `date`/`startTime` are
// wall-clock strings in DEMO_BOOKING_TIMEZONE (see lib/demoBookingConfig.js), like SchoolAttendanceConfig.openTime,
// rather than an absolute UTC instant.
model DemoBooking {
  id           String   @id @default(cuid())
  name         String
  email        String
  organization String
  role         String // school_admin | org_leadership | other
  phone        String?
  notes        String?
  date         String // "YYYY-MM-DD", wall-clock in DEMO_BOOKING_TIMEZONE
  startTime    String // "HH:MM", 24h, wall-clock in DEMO_BOOKING_TIMEZONE
  status       String   @default("confirmed") // confirmed | cancelled
  // Lets the emailed manage (reschedule/cancel) link work with no login. Not the same as `id`: the id alone must never
  // be enough to manage someone else's booking.
  cancelToken  String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // No @@unique([date, startTime]): a cancelled row must free its slot, and SQLite can't express "unique among
  // non-cancelled rows". The conflict check runs in the route handler inside a transaction (see routes/scheduleDemo.js).
  @@index([date, startTime, status])
}
