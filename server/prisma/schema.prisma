// Prisma schema for the Teacher Assistant.
// SQLite for the pilot; switching to PostgreSQL later only requires changing
// the datasource provider + DATABASE_URL and re-running migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A school is the tenant boundary. The `code` picks the tenant at sign-UP;
// sign-in needs only an email, so a returning teacher never has to know it.
model School {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  district  String?
  state     String?
  createdAt DateTime @default(now())

  users                  User[]
  queries                Query[]
  events                 Event[]
  resources              Resource[]
  supportTickets         SupportTicket[]
  // Classroom Management (docs/classroom-feature-plan.md) — denormalized
  // alongside SchoolClass.teacherId, NEVER used for row-level access (every
  // Classroom query filters on teacherId only). Reserved for a possible
  // future school-admin rollup view; unused by any V1 route.
  schoolClasses          SchoolClass[]
  conversations          Conversation[]
  // Teacher Attendance (docs/feature-teacher-attendance-implementation-plan.md)
  attendanceConfig       SchoolAttendanceConfig?
  teacherAttendances     TeacherAttendance[]
  holidays               SchoolHoliday[]
  attendanceActivityLogs TeacherAttendanceActivityLog[]
}

// Roles: teacher | school_admin | resource_person | super_admin
//
// Identity is `email` (not `name`): common teacher names collide within a
// single school, and email unifies the manual signup path with Google
// sign-in, which always supplies a verified email. `name` is retained purely
// as a display field (Manage table, app header, exam letterhead) and is
// deliberately NOT unique any more.
//
// `status` gates sign-in: every new signup — manual or Google — starts as
// `pending` and only a school_admin/super_admin can move it to `active`.
model User {
  id               String    @id @default(cuid())
  school           School    @relation(fields: [schoolId], references: [id])
  schoolId         String
  name             String
  email            String
  displayName      String?
  preferences      String? // JSON string of teacher preferences (defaults + responseStyle + avatar)
  role             String    @default("teacher")
  // Set for accounts created through the email+password path. Null for
  // Google-only accounts, which have no local secret to verify.
  passwordHash     String?
  // Google's stable subject claim (`sub`) from a verified ID token. Indexed
  // because Google sign-in looks an identity up across every school at once.
  googleSub        String?
  status           String    @default("active") // active | pending | rejected
  // Legacy: the pre-email name+PIN credential. Retained so the migration
  // never has to drop a column; no current code path reads or writes it.
  pinHash          String?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLogin        DateTime?
  createdAt        DateTime  @default(now())

  queries                Query[]
  feedback               Feedback[]
  events                 Event[]
  sessions               Session[]
  resources              Resource[]
  passwordResetTokens    PasswordResetToken[]
  supportTickets         SupportTicket[]
  supportNotes           SupportNote[]
  profilePicture         ProfilePicture?
  notifications          Notification[]
  // OS-level push registrations (Phase 7b, docs/mobile-app-plan.md §15/§26).
  // One row per installed-app instance the teacher has signed into, not one
  // per user — see DeviceToken's own doc comment.
  deviceTokens           DeviceToken[]
  // Classroom Management (docs/classroom-feature-plan.md) — a teacher's own
  // classes. Every class/student/attendance/fee row is scoped to teacherId,
  // never schoolId (see SchoolClass's own doc comment) — teacher A never
  // sees teacher B's classes/students/attendance/fees, even within the same
  // school.
  schoolClasses          SchoolClass[]
  conversations          Conversation[]
  // Teacher Attendance (docs/feature-teacher-attendance-implementation-plan.md)
  // — this teacher's own check-in/check-out days, and (for a school_admin)
  // the review actions they've taken on other teachers' flagged days.
  teacherAttendances     TeacherAttendance[]
  attendanceReviews      TeacherAttendanceReview[]
  attendanceActivityLogs TeacherAttendanceActivityLog[]

  // A teacher's email is unique within a school. The same email may hold
  // accounts at more than one school, which is why sign-in looks up by email
  // across schools and asks the user to disambiguate when it matches several.
  @@unique([schoolId, email])
  @@index([googleSub])
}

// A teacher's custom uploaded profile picture — kept in its own table, never
// as columns on User, so an ordinary prisma.user.findMany()/findUnique() can
// never accidentally pull image bytes into memory; only code that explicitly
// selects `data` (the serving route) ever touches them. One row per user
// (upsert on upload, deleted on removal); presence/absence of the row is
// itself the "has a custom photo" flag — see publicUser() in routes/auth.js,
// which reads only `updatedAt` to build a cache-busted avatarUrl and never
// loads `data` for that DTO.
model ProfilePicture {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  data      Bytes
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A single-use, time-limited password-reset token. Mirrors the Session model's
// discipline exactly: the raw token goes out in the reset email and is never
// stored — only its SHA-256 hash (see hashToken in middleware/auth.js), so a
// database leak cannot be replayed into account takeovers. `usedAt` makes
// redemption single-use even inside the expiry window.
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A refresh-token session, so a login can be revoked server-side instead of
// only expiring after TOKEN_TTL. The raw refresh token is never stored —
// only its SHA-256 hash. Rotated on every /auth/refresh call; `replacedBy`
// links a session to the one that superseded it, so a reused (already
// rotated-out) token can be detected as likely theft.
model Session {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  lastUsedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// Every coaching request is persisted for history + analytics.
model Query {
  id                 String   @id @default(cuid())
  user               User?    @relation(fields: [userId], references: [id])
  userId             String?
  school             School?  @relation(fields: [schoolId], references: [id])
  schoolId           String?
  queryText          String
  language           String   @default("en")
  context            String? // JSON string of { grade, subject, classroomType, issueType }
  responseText       String
  responseTimeMs     Int?
  finishReason       String?
  // Classroom Mode's plan for this turn, as a JSON string, or NULL for every
  // ordinary question (docs/classroom-mode.md D24). Nullable and additive on
  // purpose: a row written before this column existed, and every row written
  // by a teacher who never uses the mode, is simply NULL — so nothing that
  // reads a Query needs to know this column exists.
  //
  // Stores the PLAN (topic, grade, subject, language, which artifacts fit),
  // never the generated artifacts themselves — those are still only saved by
  // an explicit teacher action (D11).
  classroomPlan      String?
  // The artifacts Classroom Mode generated for this turn, as a JSON object of
  // { artifactKind: markdown } (docs/classroom-mode.md D25). NULL for every
  // ordinary question.
  //
  // ⚠️ NEVER select this in a LIST query. It holds up to five full documents;
  // a 20-row history that pulled it would move hundreds of kilobytes to render
  // a sidebar. routes/queries.js uses an explicit `select` for exactly this
  // reason, and the artifacts are fetched on demand for ONE turn instead.
  classroomArtifacts String?
  createdAt          DateTime @default(now())
  // Teacher-set display label for this history entry (Sidebar's three-dot
  // "Rename chat"). NULL for every row written before this column existed,
  // and for any row the teacher has never renamed — the client falls back to
  // showing `queryText` in that case, so nothing that reads a Query needs a
  // migration-aware branch. Never written to or read from `queryText` itself:
  // that field stays the original question, unedited, since it's also what
  // reopening this entry from history replays as the turn's user message.
  title              String?
  // "Pin chat" (Sidebar three-dot menu). Defaulted false, not nullable — a
  // pin is a plain boolean state, not a "was this ever set" question the way
  // `title`'s NULL-vs-empty distinction is, so every existing row backfills
  // to the same unpinned default a freshly created one gets.
  pinned             Boolean  @default(false)

  feedback Feedback[]

  @@index([userId])
  @@index([schoolId])
  @@index([createdAt])
}

// Documenting an existing table, not adding a new feature: this model (and
// Message below) existed only in the live dev.db's applied-migrations
// history — the migration that created them (20260720193726) was applied
// but its file was never committed, so `schema.prisma` never described them
// either. No route or lib in this codebase reads/writes Conversation or
// Message (grep confirms zero references) — they appear to be an abandoned
// prototype. Documented here as-is, matching the live table exactly, so
// schema.prisma and the database agree and future migrations don't try to
// drop them. Not part of any current feature; do not build on these without
// first checking whether they're actually meant to be reused or removed.
model Conversation {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId   String
  title      String?
  language   String    @default("en")
  classLevel String?
  subject    String?
  topic      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  messages   Message[]

  @@index([userId])
  @@index([schoolId])
  @@index([createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           String
  content        String
  language       String?
  classLevel     String?
  subject        String?
  topic          String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([conversationId, role, createdAt])
  @@index([createdAt])
}

// Thumbs up/down on a response.
model Feedback {
  id        String   @id @default(cuid())
  query     Query    @relation(fields: [queryId], references: [id])
  queryId   String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  rating    String // helpful | not_helpful
  createdAt DateTime @default(now())

  @@index([queryId])
}

// Generic analytics events (voice_used, etc.).
model Event {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  school    School?  @relation(fields: [schoolId], references: [id])
  schoolId  String?
  type      String
  metadata  String? // JSON string
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

// A teacher-owned saved resource: the backing store for "My Library" and
// (later) the Lesson Plan Workspace. Ownership is always the authenticated
// user; resources are private to their owner. `structured` holds the
// lesson-plan fields as a JSON string (only for type = lesson_plan), mirroring
// the JSON-in-String convention used elsewhere (preferences, context).
// `sourceQueryId` is a soft link back to the originating history entry (NOT a
// foreign key), so clearing history never cascades into saved resources.
model Resource {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  school        School?  @relation(fields: [schoolId], references: [id])
  schoolId      String?
  type          String   @default("general") // lesson_plan | classroom_activity | assessment | explanation | general
  title         String
  grade         String?
  subject       String?
  language      String   @default("en")
  content       String   @default("") // markdown body
  structured    String? // JSON string of structured lesson-plan fields
  sourceQueryId String? // soft reference to the originating Query (no FK)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@index([createdAt])
}

// Help & Support: bug reports and lightweight feedback, both filed through the
// same "Need Help?" entry point (see docs/help-support-architecture.md). One
// model with a `type` discriminator (bug | feedback) rather than a model per
// flow — mirrors how Resource holds several kinds under one table above,
// since bug reports and feedback share every column and differ only in which
// ones are required. Contact Support creates no row at all in Phase 1 (a
// WhatsApp deep link built client-side); a future in-app fallback would reuse
// this same table.
//
// `context` is a JSON string, same convention as User.preferences and
// Query.context — auto-captured, non-sensitive diagnostic fields (route,
// build id, browser, requestId, …). Deliberately loose-typed so a future field
// (e.g. a diagnostics export) never needs a migration. It never carries the
// AI prompt/answer or a screenshot; those are opt-in additions planned for
// Phase 2, as their own explicit fields once they exist.
model SupportTicket {
  id          String   @id @default(cuid())
  type        String // bug | feedback
  category    String? // closed vocabulary, different per type — see routes/support.js
  description String   @default("") // required for bug, optional for feedback (enforced in routes/support.js)
  status      String   @default("open") // open | triaged | resolved | wont_fix
  user        User?    @relation(fields: [userId], references: [id])
  userId      String?
  school      School?  @relation(fields: [schoolId], references: [id])
  schoolId    String?
  context     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notes SupportNote[]

  @@index([status])
  @@index([type])
  @@index([schoolId])
  @@index([createdAt])
  // Both added in Phase 2 (the admin inbox) — Phase 1 never filtered or
  // searched on either, so neither needed an index until now.
  @@index([category])
  @@index([userId])
}

// A single admin-configurable runtime override — e.g. a temporary
// feature-flag toggle set from Admin Settings > Feature Management (see
// lib/systemSettings.js). Absence of a row for a given key is a first-class
// state, not an error: it means "no override yet", and the caller falls back
// to that feature's existing env-var default. `updatedById` is a soft
// reference to the acting admin (not a FK — mirrors Resource.sourceQueryId's
// precedent above), since the durable audit trail is the Event row the same
// write also creates, not this table.
model SystemSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// A single notification, one row PER RECIPIENT (fan-out on write, not a
// broadcast + read-receipt join table) — mirrors how Event already does one
// row per user per occurrence. Simpler to query ("my unread count" is one
// indexed WHERE), and pilot-scale (a school's teacher count) never makes the
// fan-out write expensive; createMany() is used for multi-recipient sends
// (see lib/notificationService.js) so a broadcast is one INSERT, not N round
// trips. See docs/notification-system-plan.md §3.
model Notification {
  id          String    @id @default(cuid())
  recipient   User      @relation(fields: [recipientId], references: [id])
  recipientId String
  // Closed vocabulary — see lib/notificationTypes.js (server) /
  // config.ts NOTIFICATION_TYPES (client), same CHANGE-11 duplication
  // convention as every other closed vocabulary in this app.
  type        String
  title       String
  message     String
  // Relative in-app path the client navigates to on click (e.g.
  // "/library/<id>"), or null for a notification with nothing to open.
  // Never an absolute URL.
  link        String?
  read        Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  // Soft reference to the sending admin, or null for a system/AI-generated
  // notification. NOT a FK — mirrors SystemSetting.updatedById: the durable
  // record is this row itself, and an admin's account is never blocked from
  // deletion by rows they sent. Denormalized alongside the name/role so a
  // broadcast to hundreds of recipients never needs a join just to render
  // "Sent by <name> (<role>)".
  senderId    String?
  senderName  String?
  senderRole  String?
  // Optional extra context as a JSON string, same convention as
  // Query.context / SupportTicket.context.
  metadata    String?

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
  @@index([type])
}

// OS-level push registration (Phase 7b, docs/mobile-app-plan.md §15/§26) — one
// row per installed mobile app instance, NOT one per user: the same teacher
// signed into the app on two phones holds two rows, and `token` (not
// `userId`) is the unique key so re-registering the same installation under a
// different account (a shared/reset device) reassigns the row instead of
// creating a duplicate (see the upsert in routes/notifications.js).
// notificationService.js's createNotification/createBroadcast choke point
// reads these rows to decide who gets an Expo push alongside the existing
// realtime Socket.IO emit — additive, never a replacement for either the
// in-app list or the realtime bell.
model DeviceToken {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  // The Expo push token itself (e.g. "ExponentPushToken[xxxxxxxx]"), not a
  // raw FCM/APNs token — Expo's push service is the delivery mechanism this
  // phase uses (docs/mobile-app-plan.md §29 point 5), so this is what
  // sendPushNotificationsAsync() is called with directly.
  token      String   @unique
  // 'ios' | 'android' — informational only today (nothing branches on it yet);
  // kept for the same reason Session.userAgent is kept, in case a future
  // "signed-in devices" style screen wants to show it.
  platform   String
  createdAt  DateTime @default(now())
  // Bumped on every successful re-registration (app launch, token refresh) —
  // not currently read by any query, but the natural place to add a staleness
  // sweep later without a schema change if Expo's own delivery errors turn out
  // not to be a complete enough cleanup signal on their own.
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// An admin's internal note on a SupportTicket (Phase 2: the admin inbox).
// Never exposed to the ticket's submitter — there is no teacher-facing
// endpoint that returns these rows, by omission rather than a per-field
// permission check. Append-only from the UI's perspective (no edit/delete
// exposed yet); a note can be candid ("teacher error, not a bug") without
// that risking exposure to the person who filed the ticket.
model SupportNote {
  id        String        @id @default(cuid())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  ticketId  String
  author    User          @relation(fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Classroom Management — see docs/classroom-feature-plan.md.
//
// A teacher-first workspace: My Classes / Students / Attendance / Fees /
// Reports. Isolation is PER TEACHER (teacherId), not per school — two
// teachers at the same school are as isolated from each other as two
// teachers at different schools. Every route filters strictly on
// `teacherId: req.user.id`; there is no cross-teacher visibility in V1 (see
// routes/classroom.js and test/classroom-tenant-isolation.test.js).
//
// NOT to be confused with the unrelated "Classroom Mode" AI chat feature
// (Query.classroomPlan/classroomArtifacts, CLASSROOM_MODE_ENABLED above,
// docs/classroom-mode.md) — that feature plans/generates lesson artifacts
// inside a chat turn and has no classes, students, attendance, or fees.
// ---------------------------------------------------------------------------

// A teacher's own class (e.g. "Class 5-A"). Owned by exactly one teacher —
// mirrors Resource's ownership model, not School's shared-tenant model: two
// teachers at the same school each create and see only their own
// SchoolClass rows, there is no shared "the school's 5-A" entity.
model SchoolClass {
  id        String   @id @default(cuid())
  teacher   User     @relation(fields: [teacherId], references: [id])
  teacherId String
  // Denormalized alongside teacherId, same convention as Resource.schoolId —
  // never used for row-level access (ownership is always teacherId), only
  // reserved for a possible later school-admin rollup (not built in V1).
  school    School?  @relation(fields: [schoolId], references: [id])
  schoolId  String?
  name      String // "Class 5-A"
  grade     String? // reuses the GRADES vocabulary where useful, free text otherwise
  section   String? // "A", "B" — split out since Attendance/Reports may filter by it later
  // Expected monthly fee for every (active) student in this class, in whole
  // rupees (no paise — school fees don't need that precision, and it avoids
  // conversion logic everywhere). Null until a teacher sets one (existing
  // classes are unaffected). The first time a teacher records a payment for
  // a student+period (the first PATCH, which creates that FeeRecord row),
  // this value is copied into the row's `expectedAmount` — see FeeRecord
  // below — so editing feeAmount later only affects periods not yet
  // touched; a period a teacher already recorded a payment for keeps the
  // amount that was in effect then. See docs/fee-tracking-amounts-plan.md.
  feeAmount Int?
  archived  Boolean  @default(false) // soft-delete: a class with attendance history is never hard-deleted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students Student[]

  @@index([teacherId])
  @@index([teacherId, archived])
}

// A student belongs to exactly one class (and transitively one teacher).
// Deliberately minimal today (name only) per the spec, but shaped for
// growth: `details` is an open JSON string (same convention as
// User.preferences/Query.context) for roll number, parent contact, DOB, etc.
// WITHOUT a migration when that's needed — the same reasoning that already
// justifies Resource.structured.
model Student {
  id          String      @id @default(cuid())
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  classId     String
  // Denormalized for the same reason SchoolClass.teacherId is — every
  // ownership check filters on this directly rather than joining through
  // SchoolClass, exactly like Resource.userId does today.
  teacherId   String
  name        String
  rollNumber  String? // optional now; first concrete field beyond `details`
  active      Boolean     @default(true) // soft-delete: preserves attendance/fee history
  details     String? // JSON string — future fields (contact, DOB, guardian) land here first
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  attendance AttendanceRecord[]
  feeRecords FeeRecord[]

  @@index([classId])
  @@index([teacherId])
}

// One row per student per calendar day — mirrors Event/Notification's
// "fan-out on write, never mutate a summary" convention. A student with NO
// row for a given date is UNMARKED for that date — "unmarked" is never
// itself a stored status value (see routes/classroom.js). Month-wise views
// and the percentage summary are computed by aggregation queries, not
// stored, so the source of truth never drifts from a stale rollup.
model AttendanceRecord {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id])
  studentId String
  // Denormalized, same reasoning as Student.teacherId — every list/summary
  // query is teacher-scoped and this avoids a join through Student→SchoolClass.
  teacherId String
  classId   String
  date      DateTime // stored at UTC midnight for the calendar date
  status    String // "present" | "absent" — closed vocabulary, see routes file
  markedAt  DateTime @default(now())

  // One attendance mark per student per day — the DB enforces the invariant
  // the UI relies on ("today's attendance" is unambiguous), and a re-mark is
  // an update, not a duplicate insert.
  @@unique([studentId, date])
  @@index([classId, date])
  @@index([teacherId, date])
}

// One row per student per month — a payment record, not a full ledger.
// Modeled as one-row-per-period (like AttendanceRecord) rather than a single
// mutable field on Student, so "review previous months" falls out of the
// schema for free.
model FeeRecord {
  id             String    @id @default(cuid())
  student        Student   @relation(fields: [studentId], references: [id])
  studentId      String
  teacherId      String
  classId        String
  // "2026-08" — a plain string, not a DateTime, since a fee period is always
  // a whole calendar month with no day/time component; avoids timezone
  // ambiguity a DateTime would introduce for something that's really just a
  // label.
  period         String
  status         String    @default("pending") // "paid" | "partial" | "pending" — derived server-side from amount vs expectedAmount, never set directly by the client (see routes/classroom.js)
  amount         Int? // amount actually paid so far this period, in whole rupees; null/0 = nothing paid yet
  // Snapshot of SchoolClass.feeAmount taken the first time this period's
  // record is created (routes/classroom.js's upsert `create` branch) — fixed
  // after that even if the class's feeAmount is edited later, so a past
  // month's "amount pending" doesn't silently change. Null if the class had
  // no feeAmount set yet when this row was created (falls back to a
  // status-only paid/pending read, same as pre-amount-tracking behavior).
  expectedAmount Int?
  paidAt         DateTime? // set to the time of the most recent payment update
  note           String?
  updatedAt      DateTime  @updatedAt

  @@unique([studentId, period])
  @@index([classId, period])
  @@index([teacherId, period])
}

// ---------------------------------------------------------------------------
// Teacher Attendance — see docs/feature-teacher-attendance-implementation-plan.md
// and docs/attendance-plan-review.md (the policy decisions this schema
// implements).
//
// NOT to be confused with the unrelated Classroom Management models above
// (SchoolClass/Student/AttendanceRecord/FeeRecord) — those record STUDENT
// attendance a teacher marks for their own class. These models record a
// TEACHER's own attendance, reviewed by their school's Principal
// (role = school_admin).
// ---------------------------------------------------------------------------

// One row per school. Holds only what this feature needs — kept separate
// from School itself so a school with the feature off carries no
// attendance-specific columns, and so School's own doc comment/shape stays
// unchanged by this feature.
model SchoolAttendanceConfig {
  id       String @id @default(cuid())
  school   School @relation(fields: [schoolId], references: [id])
  schoolId String @unique

  openTime           String // "09:00", 24h IST wall-clock time
  closeTime          String // "16:00"
  checkinWindowStart String // "08:30"
  checkinWindowEnd   String // "10:00"
  // Comma-separated day-of-week numbers this school is closed every week —
  // JS Date.getDay() convention (0=Sunday..6=Saturday), same comma-separated
  // convention as TEACHER_ATTENDANCE_ALLOWED_SCHOOL_CODES. Default "0" —
  // Sunday off — the common case; a school with alternate/every Saturday
  // off too sets "0,6". Checked alongside SchoolHoliday before a check-in
  // is allowed at all — see lib/teacherAttendance.js's isWeeklyOff().
  weeklyOffDays      String @default("0")

  lateGraceMinutes           Int @default(10)
  halfDayThresholdPercent    Int @default(50)
  fullDayGraceMinutes        Int @default(15)
  earlyDepartureGraceMinutes Int @default(15)

  geofenceLat          Float
  geofenceLon          Float
  geofenceRadiusMeters Int   @default(180)

  repeatPatternThreshold  Int @default(3)
  repeatPatternWindowDays Int @default(30)

  // The checkout reminder's own timing (lib/teacherAttendanceReminder.js) —
  // previously fixed at 15/30 in code with no way for a Principal to change
  // it. Same "informational rule becomes a real setting" reasoning as every
  // other grace-period field above.
  reminderMinutesBeforeClose Int @default(15)
  reminderMinutesAfterClose  Int @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per teacher per calendar date. Raw check-in/check-out evidence
// (the checkIn*/checkOut* fields) is the source of truth; status and every
// other derived field are always recomputed by the shared functions in
// lib/teacherAttendance.js — never hand-written by a route, same discipline
// as classroomAttendance.js's attendancePercentage()/deriveUnmarked().
model TeacherAttendance {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id])
  userId   String
  school   School @relation(fields: [schoolId], references: [id])
  schoolId String
  date     String // "YYYY-MM-DD", IST calendar date

  checkInAt             DateTime?
  checkInLat            Float?
  checkInLon            Float?
  checkInAccuracyMeters Float?
  checkInDistanceMeters Float?
  checkInDeviceId       String?

  checkOutAt             DateTime?
  checkOutLat            Float?
  checkOutLon            Float?
  checkOutAccuracyMeters Float?
  checkOutDistanceMeters Float?
  checkOutDeviceId       String?

  // present | late | half_day | absent | on_leave | on_duty |
  // pending_regularization | flagged_review — attendance-plan-review.md §4/§9.
  status                String
  lateMinutes           Int?
  earlyDepartureMinutes Int?
  workingMinutes        Int?
  shortfallMinutes      Int?

  // Free text on purpose, not a fixed enum — the official leave/duty
  // category list is still pending from the department. Changing the
  // allowed values later needs no migration.
  leaveOrDutyCategory String?
  leaveOrDutyReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews TeacherAttendanceReview[]

  // One attendance row per teacher per day — the DB enforces the invariant
  // routes rely on, mirroring AttendanceRecord's @@unique([studentId, date]).
  @@unique([userId, date])
  @@index([schoolId, date])
}

// Append-only audit trail. A Principal action NEVER overwrites
// TeacherAttendance's original fields — it adds a row here, and only then
// updates TeacherAttendance's derived status. Mirrors Session's "never
// delete, mark revoked" discipline already used in this schema.
model TeacherAttendanceReview {
  id               String            @id @default(cuid())
  attendance       TeacherAttendance @relation(fields: [attendanceId], references: [id])
  attendanceId     String
  reviewedBy       User              @relation(fields: [reviewedByUserId], references: [id])
  reviewedByUserId String
  // approve | correct_checkin | correct_checkout | mark_on_leave |
  // mark_on_duty | reject — see lib/teacherAttendanceSchema.js's REVIEW_ACTIONS.
  action           String
  previousStatus   String
  newStatus        String
  // Mandatory — enforced in teacherAttendanceSchema.js's Zod schema, not
  // just documented here. attendance-plan-review.md §11: "every approval or
  // correction must include a written reason — it can't be a blank
  // 'approve' click."
  reason           String
  createdAt        DateTime          @default(now())

  @@index([attendanceId])
}

// A one-off non-working day for a school — department-set (the yearly
// calendar) or Principal-set (an emergency closure). attendance-plan-review.md
// §8/§9.
model SchoolHoliday {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id])
  schoolId  String
  date      String // "YYYY-MM-DD"
  reason    String
  source    String // "department" | "principal_emergency"
  createdAt DateTime @default(now())

  @@unique([schoolId, date])
}

// Every meaningful attendance-related event, whether or not it changed a
// TeacherAttendance row — login, check-in, check-out, a blocked attempt,
// a correction, a settings change, a reminder firing. Separate from
// TeacherAttendanceReview (which stays scoped to Principal corrections
// specifically): most rows here — a plain check-in, a blocked attempt, a
// reminder — were never a "review" of anything, and there's no queue
// left for a review-style audit trail to resolve against. See
// docs/feature-teacher-attendance-implementation-plan.md §1.10/§3.
model TeacherAttendanceActivityLog {
  id       String @id @default(cuid())
  school   School @relation(fields: [schoolId], references: [id])
  schoolId String
  user     User   @relation(fields: [userId], references: [id])
  userId   String // whose day this event is about

  // Set only when different from userId — e.g. an admin correcting
  // someone else's record. Plain id, not a relation: this is a log, not
  // something ever queried "give me every log row this admin performed."
  performedBy String?

  // login | check_in | check_out | check_in_blocked | check_out_blocked |
  // missing_checkout | correction | mark_on_leave | mark_on_duty |
  // holiday_changed | settings_changed | reminder_sent
  action String

  result         String? // short human-readable summary, e.g. "63m from school" or "blocked, 410m away"
  lat            Float?
  lon            Float?
  distanceMeters Float?
  // JSON, only for actions that need extra detail (old/new values on a
  // correction or settings change).
  metadata       String?

  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
}
