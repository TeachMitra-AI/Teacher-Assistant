// Prisma schema for the Teacher Assistant.
// SQLite for the pilot; switching to PostgreSQL later only requires changing
// the datasource provider + DATABASE_URL and re-running migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A school is the tenant boundary. Teachers log in with the school `code`.
model School {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  district  String?
  state     String?
  createdAt DateTime @default(now())

  users     User[]
  queries   Query[]
  events    Event[]
  resources Resource[]
}

// Roles: teacher | school_admin | resource_person | super_admin
model User {
  id               String    @id @default(cuid())
  school           School    @relation(fields: [schoolId], references: [id])
  schoolId         String
  name             String
  displayName      String?
  preferences      String? // JSON string of teacher preferences (defaults + responseStyle + avatar)
  role             String    @default("teacher")
  pinHash          String
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLogin        DateTime?
  createdAt        DateTime  @default(now())

  queries   Query[]
  feedback  Feedback[]
  events    Event[]
  sessions  Session[]
  resources Resource[]

  // A teacher name is unique within a school.
  @@unique([schoolId, name])
}

// A refresh-token session, so a login can be revoked server-side instead of
// only expiring after TOKEN_TTL. The raw refresh token is never stored —
// only its SHA-256 hash. Rotated on every /auth/refresh call; `replacedBy`
// links a session to the one that superseded it, so a reused (already
// rotated-out) token can be detected as likely theft.
model Session {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  lastUsedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// Every coaching request is persisted for history + analytics.
model Query {
  id             String   @id @default(cuid())
  user           User?    @relation(fields: [userId], references: [id])
  userId         String?
  school         School?  @relation(fields: [schoolId], references: [id])
  schoolId       String?
  queryText      String
  language       String   @default("en")
  context        String? // JSON string of { grade, subject, classroomType, issueType }
  responseText   String
  responseTimeMs Int?
  finishReason   String?
  createdAt      DateTime @default(now())

  feedback Feedback[]

  @@index([userId])
  @@index([schoolId])
  @@index([createdAt])
}

// Thumbs up/down on a response.
model Feedback {
  id        String   @id @default(cuid())
  query     Query    @relation(fields: [queryId], references: [id])
  queryId   String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  rating    String // helpful | not_helpful
  createdAt DateTime @default(now())

  @@index([queryId])
}

// Generic analytics events (voice_used, etc.).
model Event {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  school    School?  @relation(fields: [schoolId], references: [id])
  schoolId  String?
  type      String
  metadata  String? // JSON string
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

// A teacher-owned saved resource: the backing store for "My Library" and
// (later) the Lesson Plan Workspace. Ownership is always the authenticated
// user; resources are private to their owner. `structured` holds the
// lesson-plan fields as a JSON string (only for type = lesson_plan), mirroring
// the JSON-in-String convention used elsewhere (preferences, context).
// `sourceQueryId` is a soft link back to the originating history entry (NOT a
// foreign key), so clearing history never cascades into saved resources.
model Resource {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  school        School?  @relation(fields: [schoolId], references: [id])
  schoolId      String?
  type          String   @default("general") // lesson_plan | classroom_activity | assessment | explanation | general
  title         String
  grade         String?
  subject       String?
  language      String   @default("en")
  content       String   @default("") // markdown body
  structured    String? // JSON string of structured lesson-plan fields
  sourceQueryId String? // soft reference to the originating Query (no FK)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@index([createdAt])
}
