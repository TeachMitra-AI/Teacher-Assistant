{
  "name": "teacher-assistant-server",
  "version": "1.0.0",
  "description": "Backend proxy for the Teacher Just-In-Time Coaching Tool. Keeps the LLM API key server-side and adds rate limiting, validation and logging.",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "prisma migrate deploy && node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/seed.js",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "generate": "prisma generate",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "vitest": "^2.1.4"
  }
}
