# Base URL of the backend API (no trailing slash).
# In production point this at your deployed server, e.g. https://api.example.org/api
VITE_API_BASE=http://localhost:3000/api

# Google OAuth 2.0 Web application Client ID (Google Cloud Console ->
# APIs & Services -> Credentials). Add the origin the client is served from
# (e.g. http://localhost:5173) as an authorized JavaScript origin.
#
# Must be the SAME value as GOOGLE_CLIENT_ID in the server's env — the server
# verifies each Google ID token's audience against it. Leave it unset to hide
# the Google buttons entirely; email + password sign-in is unaffected.
VITE_GOOGLE_CLIENT_ID=

# Google Analytics 4 (GA4) Measurement ID for this web stream (Enhanced
# Measurement — scroll, outbound clicks, etc. — is configured on the GA4
# property itself, not here). Leave unset to skip loading gtag.js entirely —
# no third-party script, no cookies, no network calls.
VITE_GA_MEASUREMENT_ID=

# ---- AI Action Router (assistant) ----
#
# Enables the client half of the assistant: the "does this look like a command?"
# gate on the composer, and the prefill hand-off into the Generator. When false,
# the client never calls an assistant endpoint at all and the app behaves exactly
# as it did before the feature existed.
#
# NOT AN INCIDENT CONTROL. This is baked in at build time, and the app is a PWA
# with service-worker caching (registerType 'autoUpdate'), so a change here
# reaches users on some later page load rather than immediately. To turn the
# feature off quickly, use ASSISTANT_ENABLED on the SERVER — that takes effect in
# under a minute and covers already-loaded clients too.
#
# Default: false.
VITE_ASSISTANT_ENABLED=false

# ---- Multimodal attachments (Coach: image/PDF upload) ----
#
# Enables the client half of the feature: the attach (paperclip) button in the
# Composer. When false, the button is never rendered at all — a deployment
# that sets nothing shows zero new UI, not a button that errors when pressed.
#
# NOT AN INCIDENT CONTROL, for the same reason as VITE_ASSISTANT_ENABLED above
# (PWA + service-worker caching). To turn the feature off quickly, use
# ATTACHMENTS_ENABLED on the SERVER — POST /api/coach/attachment returns 503
# under a minute of that change, regardless of this flag.
#
# Default: false.
VITE_ATTACHMENTS_ENABLED=false

# ---- Help & Support (bug reports + feedback) ----
#
# Enables the client half of the feature: the "Need Help?" entry point in the
# profile menu and Settings. When false, neither is rendered at all — same
# "zero new UI, not a button that errors" default as the flags above.
#
# NOT AN INCIDENT CONTROL, for the same PWA/service-worker reason as
# VITE_ASSISTANT_ENABLED above. To turn the feature off quickly, use
# HELP_SUPPORT_ENABLED on the SERVER — POST /api/support/tickets returns 503
# under a minute of that change, regardless of this flag.
#
# Default: false.
VITE_HELP_SUPPORT_ENABLED=false

# ---- AI Learning Representation System ----
#
# Enables the client half of the feature: the "View as visual" chip under an
# AI response. When false, the chip is never rendered — same "zero new UI"
# default as the flags above.
#
# NOT AN INCIDENT CONTROL, for the same PWA/service-worker reason as
# VITE_ASSISTANT_ENABLED above. To turn the feature off quickly, use
# LEARNING_REPRESENTATION_ENABLED on the SERVER — POST
# /api/coach/learning-representation returns its inert response under a
# minute of that change, regardless of this flag.
#
# Default: false.
VITE_LEARNING_REPRESENTATION_ENABLED=false

# WhatsApp number for "Contact Support", in international format with no
# leading "+", spaces, or dashes (e.g. 919999999999). Leave unset to hide the
# WhatsApp option — the in-app message form still works either way.
VITE_SUPPORT_WHATSAPP_NUMBER=

# ---- Notification System ----
#
# Enables the client half of the feature: the bell icon in the top bar and
# (for school_admin/resource_person/super_admin) the compose screen under
# Admin. When false, neither is rendered at all — same "zero new UI" default
# as the flags above.
#
# NOT AN INCIDENT CONTROL, for the same PWA/service-worker reason as
# VITE_ASSISTANT_ENABLED above. To turn the feature off quickly, use
# NOTIFICATIONS_ENABLED on the SERVER — every /api/notifications route
# returns 503 and the Socket.IO handshake rejects every connection under a
# minute of that change, regardless of this flag.
#
# Default: false.
VITE_NOTIFICATIONS_ENABLED=false

# A short build identifier auto-attached to bug reports (see
# docs/help-support-architecture.md) so a report can be matched to the deploy
# it came from. Any short string works — a commit SHA, a date, a version tag.
# Leave unset in local development; CI/deploy can set it to the commit SHA.
VITE_BUILD_ID=

# ---- Classroom Mode ----
#
# Enables the client half of the feature: the "+" mode button in the Composer.
# When false, the button is never rendered at all — same "zero new UI, not a
# button that errors when pressed" default as the flags above.
#
# NOT AN INCIDENT CONTROL, for the same PWA/service-worker reason as
# VITE_ASSISTANT_ENABLED above — and it matters more here, because Classroom
# Mode is the one feature where a single teacher action costs several model
# calls. To turn it off quickly, use CLASSROOM_MODE_ENABLED on the SERVER: it
# stops the planner and the artifact fan-out in under a minute, for
# already-loaded clients too, regardless of this flag.
#
# See docs/classroom-mode.md.
#
# Default: false.
VITE_CLASSROOM_MODE_ENABLED=false

# ---- Classroom Management ----
#
# Enables the client half of the feature: the "Classroom" link in the mobile
# bottom nav and desktop top bar, and the class/student/attendance/fee
# workspace it opens. When false, the link is never rendered — same "zero new
# UI" default as the flags above. NOT THE SAME FEATURE as
# VITE_CLASSROOM_MODE_ENABLED above — that is an unrelated AI chat feature.
#
# NOT AN INCIDENT CONTROL, for the same PWA/service-worker reason as
# VITE_ASSISTANT_ENABLED above. To turn it off quickly, use
# CLASSROOM_MANAGEMENT_ENABLED on the SERVER — every /api/classroom/* route
# returns 503 under a minute of that change, regardless of this flag.
#
# See docs/classroom-feature-plan.md.
#
# Default: false.
VITE_CLASSROOM_MANAGEMENT_ENABLED=false

# ---- Teacher Attendance -----------------------------------------------------
#
# Enables the client half of the feature: the "Attendance" link in the mobile
# bottom nav and desktop top bar, and the check-in/check-out + review pages
# it opens. When false, the link is never rendered — same "zero new UI"
# default as the flags above. NOT THE SAME FEATURE as
# VITE_CLASSROOM_MANAGEMENT_ENABLED above — that is a teacher marking their
# STUDENTS present/absent; this is a teacher's own attendance.
#
# NOT AN INCIDENT CONTROL, for the same PWA/service-worker reason as
# VITE_ASSISTANT_ENABLED above. To turn it off quickly, use
# TEACHER_ATTENDANCE_ENABLED on the SERVER — every /api/teacher-attendance/*
# route returns 503 under a minute of that change, regardless of this flag.
#
# See docs/feature-teacher-attendance-implementation-plan.md.
#
# Default: false.
VITE_TEACHER_ATTENDANCE_ENABLED=false

# ---- Structured Question Model (Generator v2) -------------------------------
#
# Enables the client half of the feature: the Quiz/Worksheet Generator's
# question-type picker offers the 3 new types (Descriptive, Fill in the Blank,
# Match the Following) and the Generator/Library edit workspace render the new
# per-question card editor (individually editable/reorderable/deletable)
# instead of the flat Markdown textarea, whenever a generated/saved document
# has native structured questions. When false (the default), the picker
# offers only the original 4 values and every screen behaves exactly as it
# did before this feature existed — "zero new UI" default, same as the flags
# above.
#
# NOT AN INCIDENT CONTROL, for the same PWA/service-worker reason as
# VITE_ASSISTANT_ENABLED above. To turn it off quickly, use
# STRUCTURED_QUESTIONS_ENABLED on the SERVER — requesting one of the 3 new
# types then 503s with STRUCTURED_QUESTIONS_DISABLED regardless of this flag.
#
# See docs/generator-v2-plan.md.
#
# Default: false.
VITE_STRUCTURED_QUESTIONS_ENABLED=false
